---
import '@/styles/global.css';
import SeoHead from '@/components/SeoHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileActionBar from '@/components/MobileActionBar.astro';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  type?: 'website' | 'restaurant' | 'article';
  breadcrumbs?: Array<{ name: string; url: string }>;
  structuredData?: Record<string, any>;
}

const props = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="tr">
  <head>
    <SeoHead {...props} />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Ana İçeriğe Geç</a>
    
    <Header currentPath={currentPath} />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <MobileActionBar />

    <!-- Google Analytics & Yerel SEO Dönüşüm Olay Takip Scripti (Gizlilik Odaklı - PII Yok) -->
    <script is:inline>
      (function() {
        function trackEvent(name, params) {
          if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
            window.gtag('event', name, params || {});
          } else if (typeof window !== 'undefined' && window.dataLayer) {
            window.dataLayer.push(Object.assign({ event: name }, params || {}));
          }
        }

        var path = window.location.pathname;
        if (path.indexOf('/menu') !== -1) {
          trackEvent('menu_view', { page_location: path });
        } else if (path.indexOf('/rezervasyon') !== -1) {
          trackEvent('reservation_start', { page_location: path });
        }

        document.addEventListener('click', function(e) {
          var target = e.target.closest('a, button');
          if (!target) return;
          var href = target.getAttribute('href') || '';
          
          if (href.indexOf('maps.app.goo.gl') !== -1 || href.indexOf('google.com/maps') !== -1) {
            trackEvent('directions_click', { destination: 'google_maps' });
          } else if (href.indexOf('tel:') === 0) {
            trackEvent('phone_click', { phone_action: 'call' });
          } else if (href === '/iletisim' || href === '/iletisim/') {
            trackEvent('contact_click', { source_location: window.location.pathname });
          } else if (href === '/menu' || href === '/menu/') {
            trackEvent('menu_view', { source_location: window.location.pathname });
          } else if (href === '/rezervasyon' || href === '/rezervasyon/') {
            trackEvent('reservation_start', { source_location: window.location.pathname });
          }
        }, { passive: true });
      })();
    </script>
  </body>
</html>
