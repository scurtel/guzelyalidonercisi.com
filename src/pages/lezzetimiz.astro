---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { businessConfig } from '@/config/business';

const pageTitle = `Döner Ustalığımız & Lezzetimiz | ${businessConfig.brandName} Adana`;
const pageDescription = 'Güzelyalı Dönercisi’nin lezzet sırları: Et seçimi, özel marine tekniği, geleneksel köz ateşinde pişirme ve masaya sıcak ulaşan yaprak kesim ustalığı.';

const breadcrumbs = [
  { name: 'Lezzetimiz', url: '/lezzetimiz' }
];

const craftSteps = [
  {
    step: '01',
    title: 'Özenli Et Seçimi ve Dinlendirme',
    text: 'Hakiki yaprak et dönerin temeli doğru etle atılır. Yerli besilerden temin edilen dana antrikot ve kuzu döş etleri, sinir ve fazla yağlarından titizlikle arındırılır. Özel baharat harmanı ve süt marinasyonunda en az 24 saat dinlendirilir.',
    image: '/images/craft/marine-et.webp',
  },
  {
    step: '02',
    title: 'Şişe Yaprak Yaprak Dizim Sanatı',
    text: 'Dinlenmiş etler usta eller tarafından tek tek, dengeli ve sıkı bir intizamla şişe takılır. Aralara yerleştirilen ince kuzu yağı katmanları, pişme esnasında eriyerek etin kurumadan sulu ve yumuşacık kalmasını sağlar.',
    image: '/images/craft/usta-kesim.webp',
  },
  {
    step: '03',
    title: 'Köz ve Odun Ateşinde Ağır Pişirme',
    text: 'Alevin etle doğrudan temas etmediği, kontrollü mesafedeki köz ısısında et ağır ağır döner. Dış yüzeyi nar gibi kızarırken, etin doğal suyu ve aroması içeride mühürlenir.',
    image: '/images/craft/koz-atesi.webp',
  },
  {
    step: '04',
    title: 'Sipariş Anında İncecik Kesim',
    text: 'Önceden kesilip ısıtıcı altında bekletilen döner lezzetini kaybeder. Güzelyalı Dönercisi’nde et, sadece sipariş verildiği anda taze ve ince yapraklar halinde kesilerek sıcacık tırnaklı pide üzerine alınır.',
    image: '/images/hero-doner.webp',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/lezzetimiz"
  breadcrumbs={breadcrumbs}
>
  <div class="page-hero">
    <div class="container">
      <span class="badge badge-brass">Geleneksel Pişirme Sanatı</span>
      <h1>Döner Ustalığımız</h1>
      <div class="divider-brass"></div>
      <p class="page-lead">
        Her lokmada hissedilen lezzet tesadüf değildir; doğru malzemenin, sabırlı terbiyenin ve usta ateş yönetiminin eseridir.
      </p>
    </div>
  </div>

  <div class="craft-section">
    <div class="container">
      <div class="craft-steps-list">
        {craftSteps.map((step, idx) => (
          <article class:list={['craft-row', { reversed: idx % 2 === 1 }]}>
            <div class="craft-media card">
              <img 
                src={step.image} 
                alt={step.title} 
                width="800" 
                height="600" 
                loading="lazy" 
                decoding="async" 
              />
              <span class="step-badge">Aşama {step.step}</span>
            </div>

            <div class="craft-content">
              <span class="step-num">{step.step}</span>
              <h2>{step.title}</h2>
              <p>{step.text}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- Tamamlayıcı Yan Lezzetler -->
      <div class="accents-box card">
        <div class="accents-header">
          <span class="badge badge-burgundy">Taze Tamamlayıcılar</span>
          <h3>Sofrayı Taçlandıran Yan Lezzetler</h3>
          <p>Dönerin lezzetini tamamlayan her garnitür, aynı titizlikle günlük hazırlanır.</p>
        </div>

        <div class="accents-grid">
          <div class="accent-item">
            <strong>Tırnak Pide & Lavaş</strong>
            <p>Taş fırından taze çıkan, dışı çıtır içi yumuşak tırnak pide ve sıcacık ince lavaş.</p>
          </div>
          <div class="accent-item">
            <strong>Manda Yoğurdu & Tereyağı</strong>
            <p>İskenderimizin üzerinde köpüren saf yayık tereyağı ve kıvamlı manda yoğurdu.</p>
          </div>
          <div class="accent-item">
            <strong>Güneydoğu Sumağı & Soğan</strong>
            <p>Doğal kaya tuzu ve zeytinyağı ile ovulan, etin ağırlığını dengeleyen sumaklı piyaz.</p>
          </div>
          <div class="accent-item">
            <strong>Közlenmiş Adana Biberi</strong>
            <p>Köz ızgarasında pişen etli yerli yeşil biberler ve köz domates ikramı.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding: 64px 0 40px;
    background-color: var(--color-surface);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 12px 0 6px;
  }

  .page-lead {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .craft-section {
    padding: 80px 0 96px;
    background-color: var(--color-bg);
  }

  .craft-steps-list {
    display: flex;
    flex-direction: column;
    gap: 72px;
    margin-bottom: 80px;
  }

  .craft-row {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 56px;
    align-items: center;
  }

  .craft-row.reversed {
    grid-template-columns: 1.15fr 1fr;
  }

  .craft-row.reversed .craft-media {
    order: 2;
  }

  .craft-row.reversed .craft-content {
    order: 1;
  }

  .craft-media {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 16 / 11;
  }

  .craft-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .craft-media:hover img {
    transform: scale(1.04);
  }

  .step-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    background-color: rgba(28, 22, 20, 0.88);
    backdrop-filter: blur(4px);
    color: var(--color-brass);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(184, 139, 74, 0.35);
  }

  .craft-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--color-brass);
    line-height: 1;
    opacity: 0.6;
  }

  .craft-content h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    color: var(--color-ink);
  }

  .craft-content p {
    font-size: 1.02rem;
    color: var(--color-ink-soft);
    line-height: 1.75;
  }

  /* Tamamlayıcı Lezzetler Kutusu */
  .accents-box {
    padding: 48px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .accents-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 36px;
  }

  .accents-header h3 {
    font-size: 1.75rem;
    margin: 10px 0 6px;
  }

  .accents-header p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .accents-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .accent-item {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 22px 18px;
    border-radius: var(--radius-sm);
  }

  .accent-item strong {
    display: block;
    color: var(--color-burgundy);
    font-size: 0.98rem;
    margin-bottom: 6px;
  }

  .accent-item p {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  @media (max-width: 992px) {
    .craft-row, .craft-row.reversed {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .craft-row.reversed .craft-media {
      order: 1;
    }

    .craft-row.reversed .craft-content {
      order: 2;
    }

    .accents-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .accents-box {
      padding: 24px 18px;
    }

    .accents-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
