---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NeYesemAssistant from '@/components/NeYesemAssistant.astro';
import { menuCategories, menuItems } from '@/data/menu';
import { businessConfig } from '@/config/business';

const pageTitle = 'Adana Güzelyalı Dönercisi Menü ve Güncel Fiyatlar';
const pageDescription = 'Güzelyalı Dönercisi et döner, tavuk döner, dürüm, pilav üstü döner ve içecek seçeneklerini güncel fiyatlarıyla inceleyin.';

const breadcrumbs = [
  { name: 'Menü', url: '/menu' }
];

const menuStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: 'Güzelyalı Dönercisi Menü',
  description: pageDescription,
  inLanguage: 'tr-TR',
  hasMenuSection: menuCategories.map((cat) => ({
    '@type': 'MenuSection',
    name: cat.title,
    description: cat.description,
    hasMenuItem: menuItems
      .filter((item) => item.category === cat.key)
      .map((dish) => ({
        '@type': 'MenuItem',
        name: dish.name,
        description: dish.description,
        image: `${businessConfig.site.url}${dish.image}`,
        offers: {
          '@type': 'Offer',
          price: dish.price,
          priceCurrency: 'TRY',
          availability: 'https://schema.org/InStock'
        }
      }))
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/menu"
  breadcrumbs={breadcrumbs}
  structuredData={menuStructuredData}
>
  <div class="menu-page-header">
    <div class="container">
      <span class="badge badge-brass">Güzelyalı Dönercisi Sofrası</span>
      <h1 class="menu-h1">Güzelyalı Dönercisi Menü</h1>
      <div class="divider-brass"></div>
      <p class="menu-intro">
        Tüm dönerlerimiz günlük dinlendirilmiş yerli etlerden, köz ateşinin ağır ağır işleyen ustalığıyla taze hazırlanır. Tüm fiyatlarımız Türk Lirası (TL) cinsindendir.
      </p>

      <div class="menu-quick-stats">
        <div class="quick-stat-item">
          <span class="stat-icon">🥩</span>
          <span class="stat-text"><strong>%100 Yerli Besi</strong> & Günlük Hazırlık</span>
        </div>
        <div class="quick-stat-divider"></div>
        <div class="quick-stat-item">
          <span class="stat-icon">🔥</span>
          <span class="stat-text"><strong>Odun & Köz Ateşi</strong> Lezzeti</span>
        </div>
        <div class="quick-stat-divider"></div>
        <div class="quick-stat-item">
          <span class="stat-icon">✨</span>
          <span class="stat-text"><strong>16 Seçkin Ürün</strong> & Şeffaf Fiyat</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Kategori Filtreleri -->
  <div class="category-nav-bar">
    <div class="container">
      <div class="category-tabs" role="tablist" aria-label="Menü Kategorileri">
        <button class="cat-tab active" data-category="all" role="tab" aria-selected="true">
          Tüm Menü (16)
        </button>
        {menuCategories.map((cat) => {
          const count = menuItems.filter((i) => i.category === cat.key).length;
          return (
            <button class="cat-tab" data-category={cat.key} role="tab" aria-selected="false">
              <span>{cat.title}</span>
              <span class="cat-count">({count})</span>
            </button>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Menü Ürünleri Listesi -->
  <div class="menu-content-section">
    <div class="container">
      {menuCategories.map((cat) => {
        const catItems = menuItems.filter((i) => i.category === cat.key);
        if (catItems.length === 0) return null;

        return (
          <section class="menu-category-group" id={`cat-${cat.key}`} data-category-group={cat.key}>
            <div class="cat-group-header">
              <div class="cat-title-wrap">
                <h2>{cat.title}</h2>
                <span class="cat-badge-pill">{catItems.length} Çeşit</span>
              </div>
              <p>{cat.description}</p>
            </div>

            <div class="menu-items-grid">
              {catItems.map((item) => (
                <article class="menu-item-card card">
                  <div class="item-media">
                    <img 
                      src={item.image} 
                      alt={`${item.name} - Güzelyalı Dönercisi Adana`} 
                      width="800" 
                      height="600" 
                      loading="lazy" 
                      decoding="async" 
                      class="item-img"
                    />
                    {item.signature && (
                      <span class="signature-pill">İmza Lezzet</span>
                    )}
                  </div>

                  <div class="item-body">
                    <div class="item-top">
                      <h3 class="item-name">{item.name}</h3>
                      <div class="item-price-badge">
                        <span class="price-val">{item.price}</span>
                        <span class="price-curr">TL</span>
                      </div>
                    </div>

                    <p class="item-desc">{item.description}</p>

                    {item.preparationNote && (
                      <p class="item-prep-note">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="12" y1="16" x2="12" y2="12"></line>
                          <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>{item.preparationNote}</span>
                      </p>
                    )}

                    <div class="item-meta">
                      {item.portion && (
                        <span class="portion-badge">{item.portion}</span>
                      )}
                      {item.tags && item.tags.map((t) => (
                        <span class="tag-badge">{t}</span>
                      ))}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        );
      })}

      <!-- Masanızı Ayırtın Bölümü -->
      <div class="menu-reservation-cta card">
        <div class="menu-rez-content">
          <span class="badge badge-brass">Sofranızı Hazırlayalım</span>
          <h2>Güzelyalı Dönercisi Sofrasında Masanızı Ayırtın</h2>
          <div class="divider-brass"></div>
          <p>
            Özel terbiye yaprak et ve tavuk dönerlerimizi, taze açma lavaşlarımızı ve zengin ikramlarımızı yerinde deneyimlemek için hemen masa rezervasyon talebinizi iletin.
          </p>
          <div class="rez-cta-buttons">
            <a href="/rezervasyon" class="btn btn-primary btn-lg menu-rez-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Masa Rezervasyonu Yap</span>
            </a>
            <a 
              href={businessConfig.contact.googleMapsUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-secondary btn-lg"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
              </svg>
              <span>Yol Tarifi Al</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lezzet Danışmanı Entegrasyonu -->
  <NeYesemAssistant />
</BaseLayout>

<style>
  .menu-page-header {
    padding: 64px 0 40px;
    background-color: var(--color-surface);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .menu-h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 12px 0 6px;
    color: var(--color-ink);
    font-family: var(--font-display);
  }

  .menu-intro {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 680px;
    margin: 0 auto 24px;
    line-height: 1.65;
  }

  .menu-quick-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 16px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border-subtle);
  }

  .quick-stat-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
  }

  .stat-icon {
    font-size: 1.2rem;
  }

  .quick-stat-divider {
    width: 1px;
    height: 20px;
    background-color: var(--color-border);
  }

  /* Kategori Navigasyon Çubuğu */
  .category-nav-bar {
    position: sticky;
    top: var(--header-height);
    z-index: 100;
    background-color: rgba(250, 247, 242, 0.98);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    padding: 14px 0;
  }

  .category-tabs {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }

  .category-tabs::-webkit-scrollbar {
    height: 4px;
  }

  .category-tabs::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 4px;
  }

  .cat-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cat-tab .cat-count {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .cat-tab:hover {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-burgundy);
    color: var(--color-burgundy);
  }

  .cat-tab.active {
    background-color: var(--color-burgundy);
    border-color: var(--color-burgundy);
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(122, 26, 34, 0.28);
  }

  /* Menü İçeriği */
  .menu-content-section {
    padding: 64px 0 88px;
    background-color: var(--color-bg);
  }

  .menu-category-group {
    margin-bottom: 64px;
    scroll-margin-top: calc(var(--header-height) + 80px);
  }

  .cat-group-header {
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--color-border);
  }

  .cat-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }

  .cat-group-header h2 {
    font-size: 1.85rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    margin: 0;
  }

  .cat-badge-pill {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-ink-soft);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
  }

  .cat-group-header p {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .menu-items-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .menu-item-card {
    display: flex;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .menu-item-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: rgba(184, 139, 74, 0.4);
  }

  .item-media {
    width: 220px;
    min-width: 220px;
    position: relative;
    background-color: var(--color-surface-subtle);
  }

  .item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .menu-item-card:hover .item-img {
    transform: scale(1.04);
  }

  .signature-pill {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #B88B4A;
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }

  .item-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }

  .item-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .item-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
    font-family: var(--font-sans);
  }

  /* Belirgin Fiyat Rozeti */
  .item-price-badge {
    display: flex;
    align-items: baseline;
    gap: 3px;
    background: linear-gradient(135deg, #1C1614 0%, #2F2624 100%);
    color: #FFFFFF;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border-left: 3px solid #B88B4A;
    box-shadow: 0 2px 6px rgba(28, 22, 20, 0.15);
    white-space: nowrap;
  }

  .price-val {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #FAF7F2;
  }

  .price-curr {
    font-size: 0.75rem;
    font-weight: 600;
    color: #B88B4A;
  }

  .item-desc {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    flex: 1;
  }

  .item-prep-note {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #8C6D37;
    background-color: #FAF5E8;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
  }

  .item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 10px;
    border-top: 1px dashed var(--color-border-subtle);
  }

  .portion-badge {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    background-color: var(--color-surface-subtle);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .tag-badge {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-burgundy);
    background-color: var(--color-burgundy-light);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 900px) {
    .menu-items-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .menu-item-card {
      flex-direction: column;
    }

    .item-media {
      width: 100%;
      height: 200px;
    }

    .quick-stat-divider {
      display: none;
    }

    .menu-quick-stats {
      flex-direction: column;
      gap: 10px;
    }

    .menu-reservation-cta {
      padding: 32px 20px;
    }

    .rez-cta-buttons {
      flex-direction: column;
    }
  }

  /* Masanızı Ayırtın CTA */
  .menu-reservation-cta {
    background: linear-gradient(135deg, #FFFFFF 0%, #FAF5EE 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 48px 36px;
    margin-top: 56px;
    text-align: center;
    box-shadow: var(--shadow-md);
  }

  .menu-rez-content {
    max-width: 680px;
    margin: 0 auto;
  }

  .menu-rez-content h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    color: var(--color-ink);
    margin: 12px 0 8px;
    font-family: var(--font-display);
  }

  .menu-rez-content p {
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .rez-cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .menu-rez-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
</style>

<script>
  function setupCategoryFiltering() {
    const tabs = document.querySelectorAll('.cat-tab');
    const groups = document.querySelectorAll('.menu-category-group');

    // Kategori eşleştirme haritası (Eski linkler ve harici yönlendirmeler için)
    const categoryAliases: Record<string, string> = {
      'donerler': 'et-doner',
      'durumler': 'et-doner',
      'porsiyonlar': 'et-doner',
      'iskender': 'et-doner',
      'yan-urunler': 'yan-urunler',
      'icecekler': 'icecekler',
      'tatlilar': 'all',
      'tavuk-doner': 'tavuk-doner',
      'et-doner': 'et-doner',
      'pilav-ustu': 'pilav-ustu'
    };

    function applyCategory(rawCat: string, scroll = false) {
      const cat = categoryAliases[rawCat] || rawCat;

      tabs.forEach((t) => {
        const tabCat = t.getAttribute('data-category');
        const isMatch = tabCat === cat;
        t.classList.toggle('active', isMatch);
        t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      groups.forEach((group) => {
        const groupEl = group as HTMLElement;
        const groupCat = groupEl.getAttribute('data-category-group');
        if (cat === 'all' || cat === groupCat) {
          groupEl.style.display = 'block';
        } else {
          groupEl.style.display = 'none';
        }
      });

      if (scroll && cat !== 'all') {
        const targetEl = document.getElementById(`cat-${cat}`);
        if (targetEl) {
          setTimeout(() => {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 100);
        }
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-category') || 'all';
        applyCategory(cat, false);
        if (cat !== 'all') {
          history.replaceState(null, '', `#cat-${cat}`);
        } else {
          history.replaceState(null, '', window.location.pathname);
        }
      });
    });

    // Hash kontrolü (örn: /menu#cat-et-doner veya /menu#cat-iskender)
    if (window.location.hash) {
      const hashCat = window.location.hash.replace(/^#cat-/, '');
      applyCategory(hashCat, true);
    }
  }

  setupCategoryFiltering();
  document.addEventListener('astro:after-swap', setupCategoryFiltering);
</script>
