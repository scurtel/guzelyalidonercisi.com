---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { businessConfig } from '@/config/business';

const pageTitle = `Hakkımızda | ${businessConfig.brandName} Adana`;
const pageDescription = 'Güzelyalı Dönercisi’nin kuruluş felsefesi: Adana’da hakiki et döner ustalığı, özenle seçilen yerli etler ve şeffaf mutfak kültürüyle yeni bir soluk.';

const breadcrumbs = [
  { name: 'Hakkımızda', url: '/hakkimizda' }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/hakkimizda"
  breadcrumbs={breadcrumbs}
>
  <!-- Başlık -->
  <div class="page-hero">
    <div class="container">
      <span class="badge badge-brass">Yeni Bir Lezzet Yolculuğu</span>
      <h1>Hakkımızda</h1>
      <div class="divider-brass"></div>
      <p class="page-lead">
        Adana’nın köklü et kültürüne duyduğumuz saygıyı, modern ve tertemiz bir döner salonu anlayışıyla buluşturuyoruz.
      </p>
    </div>
  </div>

  <!-- Ana İçerik -->
  <div class="about-content-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-text-col">
          <span class="badge badge-burgundy">Biz Kimiz?</span>
          <h2>Güzelyalı’da Yeni, <br /><span class="text-burgundy">Gelenekte Samimi</span></h2>
          
          <p>
            Güzelyalı Dönercisi; yarım asırlık abartılı hikayelere sığınmak yerine, bugünün en doğru, en temiz ve en dürüst dönerini yapma kararlılığıyla Adana Çukurova’da kuruldu. Bizim için döner; aceleye getirilmiş sıradan bir fast-food değil, etin seçiminden terbiyesine, şişe takılışından köz ateşindeki dansına kadar sabır gerektiren bir zanaattir.
          </p>

          <p>
            Adana gibi damağı son derece seçici ve etten gerçekten anlayan bir şehirde döner sunmanın büyük bir sorumluluk olduğunu biliyoruz. Bu yüzden menümüzdeki her lezzeti, kendi ailemize ikram etmekten gurur duyacağımız tazelik ve titizlikle hazırlıyoruz.
          </p>

          <div class="quote-card">
            <blockquote>
              "İyi bir dönerin sırrı gizli formüllerde değil; etin kalitesine duyulan saygıda, köz ateşinin sabrında ve misafire gösterilen samimi özende yatar."
            </blockquote>
          </div>

          <h3>Temel İlkelerimiz</h3>
          <ul class="values-list">
            <li>
              <strong>Dürüst Et Politikası:</strong> Kıyma karışımı, soya veya kimyasal yumuşatıcılar mutfağımızın kapısından içeri giremez. Yalnızca dinlendirilmiş yerli dana antrikot ve kuzu eti kullanılır.
            </li>
            <li>
              <strong>Şeffaf ve Açık Mutfak:</strong> Dönerin nasıl hazırlandığını, nasıl kesildiğini ve hangi hijyen standartlarında sunulduğunu her misafirimiz gözleriyle görebilir.
            </li>
            <li>
              <strong>Güzelyalı’ya Değer Katmak:</strong> Çukurova’nın incisi Güzelyalı Mahallesi’nde, mahalle kültürünün sıcaklığını çağdaş bir restoran konseptiyle buluşturuyoruz.
            </li>
          </ul>
        </div>

        <div class="about-visuals-col">
          <div class="visual-wrapper card">
            <img 
              src="/images/restaurant/salon.webp" 
              alt="Güzelyalı Dönercisi salonu" 
              width="1400" 
              height="788" 
              loading="lazy"
              decoding="async" 
            />
            <div class="visual-caption">
              <strong>Özenli Bir Restoran Deneyimi</strong>
              <span>Konforlu oturma alanları, zarif aydınlatma ve temiz servis.</span>
            </div>
          </div>

          <div class="visual-wrapper card secondary-visual">
            <img 
              src="/images/craft/usta-kesim.webp" 
              alt="Döner ustamız yaprak et döner keserken" 
              width="1000" 
              height="562" 
              loading="lazy"
              decoding="async" 
            />
            <div class="visual-caption">
              <strong>Zanaatkarlık ve Sabır</strong>
              <span>Sipariş anında incecik dilimlenen sıcak yaprak döner.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding: 64px 0 40px;
    background-color: var(--color-surface);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 12px 0 6px;
  }

  .page-lead {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .about-content-section {
    padding: 80px 0 96px;
    background-color: var(--color-bg);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 64px;
    align-items: flex-start;
  }

  .about-text-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-text-col .badge {
    align-self: flex-start;
  }

  .about-text-col h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    line-height: 1.25;
  }

  .text-burgundy {
    color: var(--color-burgundy);
  }

  .about-text-col p {
    font-size: 1.02rem;
    color: var(--color-ink-soft);
    line-height: 1.75;
  }

  .quote-card {
    background-color: var(--color-surface);
    border-left: 4px solid var(--color-brass);
    padding: 20px 24px;
    border-radius: var(--radius-sm);
    margin: 8px 0;
    box-shadow: var(--shadow-sm);
  }

  .quote-card blockquote {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--color-ink);
    line-height: 1.6;
  }

  .about-text-col h3 {
    margin-top: 12px;
    font-size: 1.4rem;
  }

  .values-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .values-list li {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
    padding-left: 20px;
    position: relative;
  }

  .values-list li::before {
    content: '•';
    color: var(--color-burgundy);
    font-size: 1.6rem;
    position: absolute;
    left: 0;
    top: -4px;
  }

  .values-list strong {
    color: var(--color-ink);
  }

  /* Görseller */
  .about-visuals-col {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: sticky;
    top: calc(var(--header-height) + 24px);
  }

  .visual-wrapper {
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .visual-wrapper img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .visual-caption {
    padding: 16px 20px;
    background-color: var(--color-surface);
  }

  .visual-caption strong {
    display: block;
    font-size: 0.92rem;
    color: var(--color-ink);
    margin-bottom: 2px;
  }

  .visual-caption span {
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .about-visuals-col {
      position: static;
    }
  }
</style>
