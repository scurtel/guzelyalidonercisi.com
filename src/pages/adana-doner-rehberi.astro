---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { businessConfig } from '@/config/business';

const pageTitle = 'Adana Döner Rehberi: Hakiki Döner Nasıl Seçilir? | Güzelyalı Dönercisi';
const pageDescription = "Adana'da döner nerede yenir, hakiki yaprak döner nasıl seçilir? Et kalitesi, terbiye, odun ateşi ve Çukurova döner kültürü hakkında kapsamlı gastronomi rehberi.";

const breadcrumbs = [
  { name: 'Adana Döner Rehberi', url: '/adana-doner-rehberi' }
];

const guideFaqs = [
  {
    question: "Adana'da döner hangi saatlerde en taze şekilde tüketilir?",
    answer: "Geleneksel döner salonlarında şiş genellikle sabahın ilk saatlerinde takılır ve öğle servisine (11:30 - 12:00) hazır hale gelir. Dönerin en lezzetli olduğu anlar, etin dinlenip köz ateşiyle buluştuğu öğle ve akşam saatleridir. Şiş bittiğinde yeni taze şiş takılmıyorsa günün son dilimlerine kalmamak tavsiye edilir."
  },
  {
    question: "Dönerin köz veya odun ateşinde piştiği nasıl anlaşılır?",
    answer: "Doğal ateşte pişen dönerin yüzeyinde hafif meşe isinin doğal aroması ve homojen olmayan, çıtır çıtır nar gibi bir kızarma görülür. Elektrikli ya da gazlı radyanlarda pişen dönerler ise genellikle nemli, soluk renkli veya tekdüze kurudur."
  },
  {
    question: "İyi bir Adana döner dürümünün lavaşı nasıl olmalıdır?",
    answer: "Lavaş ne çok kalın ne de etin suyunu dışarı sızdıracak kadar ince olmalıdır. Dönerin sıcaklığı ve köz biberin aromasıyla yumuşayan, mayasız veya az mayalı taze açılmış lavaş en doğru lezzet dengesini sağlar."
  },
  {
    question: "Adana dönerinde sumaklı soğan neden vazgeçilmezdir?",
    answer: "Adana kebap kültürünün en güçlü miraslarından biri olan sumaklı ince kıyım mor soğan ve taze maydanoz, etin doğal yağ dengesini asiditesiyle kırarak sindirimi kolaylaştırır ve ferahlık katar."
  }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Adana Döner Rehberi: Hakiki Yaprak Döner Nasıl Seçilir?',
  description: pageDescription,
  image: `${businessConfig.site.url}/images/craft/usta-kesim.webp`,
  author: {
    '@type': 'Organization',
    name: businessConfig.brandName,
    url: businessConfig.site.url,
  },
  publisher: {
    '@type': 'Organization',
    name: businessConfig.brandName,
    logo: {
      '@type': 'ImageObject',
      url: `${businessConfig.site.url}/favicon.svg`
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${businessConfig.site.url}/adana-doner-rehberi/`
  }
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/adana-doner-rehberi"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <article class="guide-article-wrapper">
    <!-- Rehber Başlığı -->
    <header class="guide-header">
      <div class="container guide-header-container">
        <span class="badge badge-brass">Adana Gastronomi Rehberi</span>
        <h1>Adana Döner Rehberi: <br /><span class="text-burgundy">Hakiki Yaprak Döner</span> Nasıl Seçilir?</h1>
        <div class="divider-brass"></div>
        <p class="guide-lead">
          Kebap denilince akla gelen ilk şehir olan Adana’da, döner ustalığı da en az ocakbaşı kültürü kadar derin bir özen ve uzmanlık gerektirir. Gerçek bir yaprak döneri sıradan fast-food karışımlarından ayıran temel unsurları keşfedin.
        </p>
        <div class="article-meta-bar">
          <span class="meta-author">Hazırlayan: <strong>Güzelyalı Dönercisi Mutfak Ekibi</strong></span>
          <span class="meta-separator">•</span>
          <span class="meta-location">Bölge: <strong>Çukurova / Adana</strong></span>
          <span class="meta-separator">•</span>
          <span class="meta-reading-time">Okuma Süresi: <strong>4 Dakika</strong></span>
        </div>
      </div>
    </header>

    <!-- Ana Metin & Görseller -->
    <div class="container guide-content-layout">
      <main class="guide-main-body">
        <section class="guide-section">
          <h2>1. Kebap Başkentinde Döner Kültürünün Doğuşu</h2>
          <p>
            Adana, etin dilini en iyi anlayan gastronomi şehirlerinin başında gelir. Bir Adanalı için etin kokusu, lif yapısı, yağ dengesi ve pişme derecesi asla tesadüfe bırakılamaz. Son yıllarda endüstriyel fast-food zincirlerinin standart ve ruhsuz dönerlerine karşı, Adana genelinde ve özellikle <strong>Çukurova Güzelyalı Mahallesi</strong> gibi nezih gastronomi akslarında hakiki yaprak et döner salonlarına yönelik büyük bir ilgi doğmuştur.
          </p>
          <p>
            Adana'da döner arayan bir lezzet tutkunu; kıyma basılmış fabrikasyon blokları değil, kasap tezgahından seçilmiş antrikot ve but parçalarının yaprak yaprak şişe dizildiği geleneksel zanaati talep eder.
          </p>
        </section>

        <section class="guide-section">
          <h2>2. Hakiki Yaprak Dönerde Aranması Gereken 5 Kalite Kriteri</h2>
          
          <div class="criteria-card-grid">
            <div class="criteria-card card">
              <span class="num-badge">01</span>
              <h3>Etin Lif Dokusu</h3>
              <p>Çatalı batırdığınızda veya dilimi incelediğinizde etin kas lifleri görünür olmalıdır. Macun gibi pürüzsüz yapılar kıyma ve katkı maddesi işaretidir.</p>
            </div>

            <div class="criteria-card card">
              <span class="num-badge">02</span>
              <h3>Doğal Kuzu Yağı Dengesi</h3>
              <p>Dönerin lezzeti ve yumuşaklığı yapay soslardan değil, şişe aralıklarla yerleştirilen kuzu döş veya kavram yağından gelmelidir. Pişerken eriyen bu yağ eti nemli tutar.</p>
            </div>

            <div class="criteria-card card">
              <span class="num-badge">03</span>
              <h3>Köz ve Meşe Kömürü Isısı</h3>
              <p>Gerçek döner yavaş pişer. Dış kabuğu karamelize olup nar gibi parıldarken iç kısmı suyunu muhafaza etmelidir. Gaz kokusu veya yanık isi olmamalıdır.</p>
            </div>

            <div class="criteria-card card">
              <span class="num-badge">04</span>
              <h3>Tırnak Pide ve Sıcak Lavaş</h3>
              <p>Et ne kadar mükemmel olursa olsun, soğuk veya bayat ekmek lezzeti yok eder. Sıcak taş fırından çıkan tırnaklı pide sofranın vazgeçilmezidir.</p>
            </div>

            <div class="criteria-card card full-width">
              <span class="num-badge">05</span>
              <h3>Taze ve Asit Dengeli Garnitürler</h3>
              <p>Közlenmiş Adana biberi, domates, taze kıyılmış sumaklı mor soğan ve maydanoz. Adana döner sofrasında gereksiz sos karmaşası yerine saf garnitür tazeliği aranır.</p>
            </div>
          </div>
        </section>

        <section class="guide-section">
          <div class="guide-image-callout">
            <img 
              src="/images/craft/usta-kesim.webp" 
              alt="Ustanın döner bıçağıyla yaprak dilimler kestiği taze döner şişi" 
              width="1200" 
              height="700" 
              loading="lazy" 
              decoding="async"
              class="guide-image"
            />
            <span class="img-caption">Ustalıkla açılmış şişten sipariş anında taze kesilen yaprak dilimler, etin suyunu tabakta muhafaza eder.</span>
          </div>
        </section>

        <section class="guide-section">
          <h2>3. Terbiye (Marinasyon) Neden Bu Kadar Önemlidir?</h2>
          <p>
            Et dönerin sertleşmeden ağızda dağılmasını sağlayan en kritik aşama terbiyedir. Bazı işletmeler süreci hızlandırmak için kimyasal marinatlar veya soda kullanırken, geleneksel Türk mutfağının sırrı <strong>doğal süt ve dinlendirme</strong> kuralında yatar.
          </p>
          <p>
            Süt asidi (laktik asit) et liflerini nazikçe gevşetir. Zeytinyağı etin nemini mühürler, taze soğan suyu ise ete doğal bir tatlılık ve iştah açıcı aroma katar. En az 24 saat bu terbiyede dinlenen et, ateşe girdiğinde suyunu dışarı bırakmaz.
          </p>
        </section>

        <section class="guide-section">
          <h2>4. Çukurova & Güzelyalı’da Döner Seçerken Nelere Bakılmalı?</h2>
          <p>
            Çukurova ilçesi, geniş bulvarları ve aile dostu yaşam alanlarıyla Adana’nın en dinamik noktalarından biridir. Güzelyalı Mahallesi’nde iyi bir döner deneyimi ararken şu 3 unsura dikkat edin:
          </p>
          <ul class="guide-bullet-list">
            <li><strong>Açık ve Görülebilir Mutfak:</strong> Döner tezgahının temizliği, ustanın hijyen kurallarına uyumu ve kesim alanı doğrudan misafirlerin gözü önünde olmalıdır.</li>
            <li><strong>Taze Kesim İlkesi:</strong> Döner siparişiniz verildiği anda şişten kesilmelidir. Kesilip benmaride veya sıcak tezgahta saatlerce bekletilen et kurur ve yağını kusar.</li>
            <li><strong>Şeffaf Ürün Bilgisi:</strong> İşletmenin etin menşeini, dana ve kuzu oranını açıkça ifade edebilmesi dürüstlüğün ilk göstergesidir.</li>
          </ul>
        </section>

        <!-- Sıkça Sorulan Sorular -->
        <section class="guide-section faq-area">
          <h2>Adana Döneri Hakkında Sıkça Sorulan Sorular</h2>
          <div class="faq-list">
            {guideFaqs.map((faq) => (
              <div class="guide-faq-card card">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      </main>

      <!-- Yan Panel: Hızlı Menü & Bağlantılar -->
      <aside class="guide-sidebar">
        <div class="sidebar-sticky-box card">
          <div class="sidebar-brand-badge">
            <span class="pulse-dot"></span>
            Açılış Hazırlığı Sürüyor
          </div>
          <h3>Güzelyalı Dönercisi</h3>
          <p class="sidebar-desc">
            Adana Çukurova Güzelyalı’da hakiki yaprak et döner ve tereyağlı İskender ustalığını çok yakında sizlerle buluşturuyoruz.
          </p>
          
          <div class="sidebar-links">
            <a href="/adana-yaprak-doner" class="sidebar-link-btn">
              <span>🥩 Yaprak Döner Ustalığımız</span>
              <span>→</span>
            </a>
            <a href="/adana-iskender" class="sidebar-link-btn">
              <span>🧈 Tereyağlı Güzelyalı İskender</span>
              <span>→</span>
            </a>
            <a href="/menu" class="sidebar-link-btn">
              <span>📋 Lezzet Menüsü</span>
              <span>→</span>
            </a>
            <a href="/rezervasyon" class="sidebar-link-btn">
              <span>📅 Masa Rezervasyonu</span>
              <span>→</span>
            </a>
          </div>

          <div class="sidebar-map-box">
            <strong>Konum:</strong>
            <p>{businessConfig.contact.address.fullText}</p>
            <a 
              href={businessConfig.contact.googleMapsUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-secondary btn-sm"
            >
              Google Haritalar'da Aç
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-article-wrapper {
    background-color: var(--color-bg);
  }

  .guide-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 72px 0 48px;
    text-align: center;
  }

  .guide-header-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .guide-lead {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-ink-soft);
    margin: 20px 0 28px;
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .meta-separator {
    opacity: 0.4;
  }

  /* Grid Düzeni */
  .guide-content-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 56px;
    padding: 64px 0 96px;
    align-items: start;
  }

  .guide-main-body {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .guide-section h2 {
    font-size: 1.65rem;
    color: var(--color-ink);
    margin-bottom: 18px;
    line-height: 1.35;
  }

  .guide-section p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-ink-soft);
    margin-bottom: 16px;
  }

  /* Kriter Kartları */
  .criteria-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 24px;
  }

  .criteria-card {
    padding: 24px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    position: relative;
  }

  .criteria-card.full-width {
    grid-column: 1 / -1;
  }

  .num-badge {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-brass);
    display: inline-block;
    margin-bottom: 8px;
  }

  .criteria-card h3 {
    font-size: 1.15rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .criteria-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Görsel Çağrısı */
  .guide-image-callout {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .guide-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .img-caption {
    display: block;
    padding: 12px 18px;
    font-size: 0.85rem;
    color: var(--color-muted);
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    font-style: italic;
  }

  .guide-bullet-list {
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .guide-bullet-list li {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 20px;
  }

  .guide-faq-card {
    padding: 24px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-brass);
  }

  .guide-faq-card h3 {
    font-size: 1.1rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .guide-faq-card p {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
    margin: 0;
  }

  /* Sidebar */
  .sidebar-sticky-box {
    position: sticky;
    top: 96px;
    padding: 32px 24px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .sidebar-brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-burgundy);
    background-color: var(--color-burgundy-light);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 14px;
  }

  .sidebar-sticky-box h3 {
    font-size: 1.35rem;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .sidebar-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: 20px;
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }

  .sidebar-link-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-ink);
    transition: all var(--transition-fast);
  }

  .sidebar-link-btn:hover {
    border-color: var(--color-brass);
    color: var(--color-burgundy);
    transform: translateX(4px);
  }

  .sidebar-map-box {
    border-top: 1px solid var(--color-border);
    padding-top: 18px;
  }

  .sidebar-map-box strong {
    font-size: 0.85rem;
    color: var(--color-ink);
    display: block;
    margin-bottom: 4px;
  }

  .sidebar-map-box p {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin-bottom: 12px;
  }

  @media (max-width: 992px) {
    .guide-content-layout {
      grid-template-columns: 1fr;
    }

    .criteria-card-grid {
      grid-template-columns: 1fr;
    }

    .sidebar-sticky-box {
      position: static;
    }
  }
</style>
