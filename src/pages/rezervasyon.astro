---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReservationForm from '@/components/ReservationForm.astro';
import { businessConfig } from '@/config/business';

const pageTitle = 'Masa Rezervasyonu | Adana Güzelyalı Dönercisi';
const pageDescription = 'Adana Güzelyalı Dönercisi için kolayca masa rezervasyon talebi oluşturun. Tarih, saat ve kişi sayısını belirleyerek rezervasyon talebinizi iletin.';

const breadcrumbs = [
  { name: 'Masa Rezervasyonu', url: '/rezervasyon' }
];

// FoodEstablishmentReservation / Restaurant structured data
const reservationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${businessConfig.site.url}/#restaurant`,
  name: businessConfig.brandName,
  url: businessConfig.site.url,
  acceptsReservations: 'True',
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${businessConfig.site.url}/rezervasyon/`,
      inLanguage: 'tr-TR',
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform'
      ]
    },
    result: {
      '@type': 'FoodEstablishmentReservation',
      name: 'Masa Rezervasyonu'
    }
  }
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/rezervasyon"
  breadcrumbs={breadcrumbs}
  structuredData={reservationStructuredData}
>
  <div class="reservation-page-hero">
    <div class="container">
      <span class="badge badge-brass">Güzelyalı Dönercisi Sofrası</span>
      <h1 class="rezervasyon-h1">Masa Rezervasyonu</h1>
      <div class="divider-brass"></div>
      <p class="reservation-lead">
        Adana Çukurova Güzelyalı Mahallesi'nde sevdiklerinizle keyifli bir sofra için masa rezervasyonu talebinizi kolayca iletin.
      </p>
    </div>
  </div>

  <section class="reservation-content-section" aria-label="Rezervasyon Alanı">
    <div class="container">
      <div class="reservation-layout-grid">
        <!-- Form Kolonu -->
        <div class="form-column">
          <ReservationForm />
        </div>

        <!-- Bilgilendirme Kolonu -->
        <div class="info-column">
          <div class="policy-card card">
            <div class="policy-header">
              <div class="policy-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
              </div>
              <h3>Rezervasyon Bilgilendirmesi</h3>
            </div>

            <div class="policy-list">
              <div class="policy-item">
                <strong>İşletme Onayı ile Kesinleşme</strong>
                <p>Web sitemiz veya WhatsApp üzerinden iletilen tüm talepler, salon müsaitliği kontrol edildikten sonra işletmemiz tarafından teyit edildiğinde kesinleşir.</p>
              </div>

              <div class="policy-item">
                <strong>Çalışma Saatleri & Servis</strong>
                <p>Tüm dönerlerimiz günlük takılan taze şişlerden kesilerek sıcak servis edilir. Servis saatlerimiz haricinde rezervasyon kabul edilmemektedir.</p>
              </div>

              <div class="policy-item">
                <strong>Kalabalık Gruplar & Özel Davetler</strong>
                <p>12 kişiyi aşan kalabalık aile ve şirket yemekleriniz için özel masa düzeni hazırlanabilmesi adına doğrudan bizimle iletişime geçebilirsiniz.</p>
              </div>

              <div class="policy-item">
                <strong>Masa Bekleme Süresi</strong>
                <p>Rezervasyon saatinizden itibaren 15 dakika boyunca masanız adınıza ayrılır. Gecikme durumunda lütfen bizi bilgilendiriniz.</p>
              </div>
            </div>

            <div class="policy-hours-box">
              <h4>Restoran Çalışma Saatleri</h4>
              <ul class="policy-hours-list">
                {businessConfig.hours.schedule.map((h) => (
                  <li>
                    <span>{h.days}</span>
                    <strong>{h.hours}</strong>
                  </li>
                ))}
              </ul>
            </div>

            <div class="policy-actions">
              <a 
                href={businessConfig.contact.googleMapsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn-secondary btn-sm"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                </svg>
                <span>Google Haritalar Yol Tarifi</span>
              </a>
              <a 
                href="/menu" 
                class="btn btn-outline btn-sm"
              >
                <span>Menüyü İncele →</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .reservation-page-hero {
    padding: 64px 0 36px;
    background-color: var(--color-surface);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .rezervasyon-h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    color: var(--color-ink);
    margin: 12px 0 8px;
    font-family: var(--font-display);
  }

  .reservation-lead {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .reservation-content-section {
    padding: 64px 0 88px;
    background-color: var(--color-bg);
  }

  .reservation-layout-grid {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 40px;
    align-items: start;
  }

  /* Bilgilendirme Kartı */
  .policy-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 36px 30px;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: calc(var(--header-height) + 24px);
  }

  .policy-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 22px;
  }

  .policy-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-burgundy-light);
    color: var(--color-burgundy);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .policy-header h3 {
    font-size: 1.25rem;
    color: var(--color-ink);
    margin: 0;
    font-family: var(--font-display);
  }

  .policy-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 24px;
  }

  .policy-item strong {
    display: block;
    font-size: 0.94rem;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .policy-item p {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .policy-hours-box {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    margin-bottom: 24px;
  }

  .policy-hours-box h4 {
    font-size: 0.92rem;
    color: var(--color-ink);
    margin: 0 0 10px;
    font-weight: 700;
  }

  .policy-hours-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .policy-hours-list li {
    display: flex;
    justify-content: space-between;
    font-size: 0.86rem;
  }

  .policy-hours-list span {
    color: var(--color-muted);
  }

  .policy-hours-list strong {
    color: var(--color-ink);
  }

  .policy-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .policy-actions .btn {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 992px) {
    .reservation-layout-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .policy-card {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .reservation-content-section {
      padding: 36px 0 60px;
    }
  }
</style>
