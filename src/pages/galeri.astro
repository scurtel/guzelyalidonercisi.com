---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { businessConfig } from '@/config/business';

const pageTitle = `Fotoğraf Galerisi | ${businessConfig.brandName} Adana`;
const pageDescription = 'Güzelyalı Dönercisi görsel galerisi: Közde pişen yaprak et dönerler, Bursa usulü İskender, sıcak lavaş dürümler ve ferah restoran atmosferi.';

const breadcrumbs = [
  { name: 'Galeri', url: '/galeri' }
];

const galleryItems = [
  {
    src: '/images/hero-doner.webp',
    title: 'Güzelyalı Yaprak Et Döner',
    category: 'doner',
    categoryName: 'Dönerlerimiz',
    caption: 'Odun ve köz ateşinde pişen, incecik dilimlenmiş hakiki yaprak döner.',
  },
  {
    src: '/images/menu/iskender.webp',
    title: 'Hakiki Bursa Usulü İskender',
    category: 'sunum',
    categoryName: 'Sunumlar',
    caption: 'Kızgın tereyağı, tırnak pide, özel domates sosu ve manda yoğurdu.',
  },
  {
    src: '/images/menu/durum-doner.webp',
    title: 'Özel Lavaş Döner Dürüm',
    category: 'doner',
    categoryName: 'Dönerlerimiz',
    caption: 'Tırnaklı sıcacık lavaş arasında bol et döner ve köz Adana biberi.',
  },
  {
    src: '/images/restaurant/salon.webp',
    title: 'Restoran Salonumuz',
    category: 'mekan',
    categoryName: 'Mekan & Atmosfer',
    caption: 'Güzelyalı Mahallesi’nde konforlu, aydınlık ve ferah oturma düzeni.',
  },
  {
    src: '/images/craft/usta-kesim.webp',
    title: 'İncecik Yaprak Kesim Sanatı',
    category: 'doner',
    categoryName: 'Dönerlerimiz',
    caption: 'Sipariş verildiği anda şişten taze olarak kesilen döner dilimleri.',
  },
  {
    src: '/images/craft/tertemiz-mutfak.webp',
    title: 'Şeffaf & Hijyenik Mutfak',
    category: 'mekan',
    categoryName: 'Mekan & Atmosfer',
    caption: 'Açık cam vitrinli, tamamen paslanmaz çelik hazırlık mutfağımız.',
  },
  {
    src: '/images/menu/katmer.webp',
    title: 'Çıtır Antep Fıstıklı Katmer',
    category: 'sunum',
    categoryName: 'Sunumlar',
    caption: 'Fırından sıcak çıkan, bol fıstıklı ve manda kaymaklı geleneksel tatlımız.',
  },
  {
    src: '/images/menu/yayik-ayran.webp',
    title: 'Açık Yayık Ayranı & Şalgam',
    category: 'sunum',
    categoryName: 'Sunumlar',
    caption: 'Geleneksel bakır maşrapada köpüklü yayık ayranı ve mor havuçlu şalgam suyu.',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/galeri"
  breadcrumbs={breadcrumbs}
>
  <div class="page-hero">
    <div class="container">
      <span class="badge badge-brass">Görsel Şölen</span>
      <h1>Fotoğraf Galerisi</h1>
      <div class="divider-brass"></div>
      <p class="page-lead">
        Köz ateşinden çıkan lezzetlerimiz, özenli sunumlarımız ve Güzelyalı’daki mekanımızdan kareler.
      </p>
    </div>
  </div>

  <div class="gallery-section">
    <div class="container">
      <!-- Filtre Butonları -->
      <div class="gallery-filters" role="tablist" aria-label="Galeri Filtreleri">
        <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">
          Tüm Fotoğraflar
        </button>
        <button class="filter-btn" data-filter="doner" role="tab" aria-selected="false">
          Dönerlerimiz
        </button>
        <button class="filter-btn" data-filter="sunum" role="tab" aria-selected="false">
          Özel Sunumlar
        </button>
        <button class="filter-btn" data-filter="mekan" role="tab" aria-selected="false">
          Mekan & Atmosfer
        </button>
      </div>

      <!-- Galeri Tablosu -->
      <div class="gallery-grid">
        {galleryItems.map((item) => (
          <div class="gallery-item card" data-category={item.category}>
            <div class="img-wrap">
              <img 
                src={item.src} 
                alt={item.title} 
                width="800" 
                height="600" 
                loading="lazy" 
                decoding="async" 
                class="gallery-thumb"
              />
              <div class="img-overlay">
                <span class="img-cat">{item.categoryName}</span>
                <h3 class="img-title">{item.title}</h3>
                <p class="img-caption">{item.caption}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Tam Boy Görsel Modalı (Lightbox) -->
  <div id="imageModal" class="image-modal" aria-hidden="true" role="dialog">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <button id="modalClose" class="modal-close" aria-label="Görseli Kapat">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <img id="modalImg" src="" alt="" class="modal-image" />
      <div class="modal-caption-bar">
        <h3 id="modalTitle"></h3>
        <p id="modalDesc"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding: 64px 0 40px;
    background-color: var(--color-surface);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 12px 0 6px;
  }

  .page-lead {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .gallery-section {
    padding: 64px 0 96px;
    background-color: var(--color-bg);
  }

  .gallery-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 48px;
  }

  .filter-btn {
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-burgundy);
    color: var(--color-burgundy);
  }

  .filter-btn.active {
    background-color: var(--color-burgundy);
    border-color: var(--color-burgundy);
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(122, 26, 34, 0.25);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .gallery-item {
    cursor: pointer;
    overflow: hidden;
  }

  .img-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .gallery-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover .gallery-thumb {
    transform: scale(1.08);
  }

  .img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28, 22, 20, 0.92) 0%, rgba(28, 22, 20, 0.3) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    color: #FAF7F2;
    opacity: 0.95;
    transition: opacity var(--transition-base);
  }

  .img-cat {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-brass);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .img-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: #FAF7F2;
    line-height: 1.3;
    margin-bottom: 6px;
  }

  .img-caption {
    font-size: 0.82rem;
    color: #D6CBC5;
    line-height: 1.45;
  }

  /* Lightbox Modal */
  .image-modal {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .image-modal.open {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(14, 11, 10, 0.92);
    backdrop-filter: blur(8px);
  }

  .modal-content {
    position: relative;
    max-width: 960px;
    max-height: 90vh;
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    z-index: 10;
    box-shadow: var(--shadow-lg);
  }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(28, 22, 20, 0.75);
    border: none;
    color: #fff;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
    transition: background 0.2s ease;
  }

  .modal-close:hover {
    background: var(--color-burgundy);
  }

  .modal-image {
    max-height: 70vh;
    width: 100%;
    object-fit: contain;
    background-color: #0E0B0A;
  }

  .modal-caption-bar {
    padding: 20px 24px;
    background-color: var(--color-surface);
  }

  .modal-caption-bar h3 {
    font-size: 1.25rem;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .modal-caption-bar p {
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  @media (max-width: 992px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 580px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupGallery() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.gallery-item');
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImg') as HTMLImageElement | null;
    const modalTitle = document.getElementById('modalTitle');
    const modalDesc = document.getElementById('modalDesc');
    const modalClose = document.getElementById('modalClose');

    // Filtreleme
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const filter = btn.getAttribute('data-filter');

        items.forEach((item) => {
          const itemEl = item as HTMLElement;
          const cat = itemEl.getAttribute('data-category');

          if (filter === 'all' || filter === cat) {
            itemEl.style.display = 'block';
          } else {
            itemEl.style.display = 'none';
          }
        });
      });
    });

    // Lightbox Açma
    if (modal && modalImg && modalTitle && modalDesc) {
      items.forEach((item) => {
        item.addEventListener('click', () => {
          const img = item.querySelector('.gallery-thumb') as HTMLImageElement | null;
          const title = item.querySelector('.img-title')?.textContent || '';
          const desc = item.querySelector('.img-caption')?.textContent || '';

          if (img) {
            modalImg.src = img.src;
            modalImg.alt = title;
            modalTitle.textContent = title;
            modalDesc.textContent = desc;
            modal.classList.add('open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }
        });
      });

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modalClose?.addEventListener('click', closeModal);
      modal.querySelector('.modal-backdrop')?.addEventListener('click', closeModal);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('open')) {
          closeModal();
        }
      });
    }
  }

  setupGallery();
  document.addEventListener('astro:after-swap', setupGallery);
</script>
