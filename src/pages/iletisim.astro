---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { businessConfig } from '@/config/business';

const pageTitle = `İletişim & Konum | ${businessConfig.brandName} Adana`;
const pageDescription = 'Güzelyalı Dönercisi Adana Güzelyalı iletişim bilgileri, adres tarifi, çalışma saatleri ve iletişim formu.';

const breadcrumbs = [
  { name: 'İletişim', url: '/iletisim' }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/iletisim"
  breadcrumbs={breadcrumbs}
>
  <div class="page-hero">
    <div class="container">
      <span class="badge badge-brass">Bize Ulaşın</span>
      <h1>İletişim & Konum</h1>
      <div class="divider-brass"></div>
      <p class="page-lead">
        Sorularınız, iş birliği veya rezervasyon/açılış hakkında bilgi almak için bizimle dilediğiniz zaman iletişime geçebilirsiniz.
      </p>
    </div>
  </div>

  <div class="contact-page-content">
    <div class="container">
      <div class="contact-grid">
        <!-- Sol Sütun: İletişim Bilgileri -->
        <div class="contact-info-col">
          <span class="badge badge-burgundy">Adana Çukurova</span>
          <h2>Güzelyalı Dönercisi İletişim Merkezi</h2>
          <p class="info-lead">
            Restoranımız Adana’nın en seçkin bölgelerinden Güzelyalı Mahallesi’nde kapılarını açmaya hazırlanıyor.
          </p>

          <div class="info-cards">
            <!-- Adres -->
            <div class="info-box card">
              <div class="info-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="info-text">
                <strong>Adres</strong>
                <p>{businessConfig.contact.address.fullText}</p>
                {!businessConfig.contact.address.hasExactAddress && (
                  <span class="sub-note">*(Açılış duyurusuyla kesin sokak ve kapı no ilan edilecektir)</span>
                )}
              </div>
            </div>

            <!-- E-posta -->
            <div class="info-box card">
              <div class="info-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="info-text">
                <strong>Kurumsal E-posta</strong>
                <p><a href={`mailto:${businessConfig.contact.email}`}>{businessConfig.contact.email}</a></p>
                <span class="sub-note">Tüm mesajlarınız aynı gün içinde yanıtlanır.</span>
              </div>
            </div>

            <!-- Telefon -->
            <div class="info-box card">
              <div class="info-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="info-text">
                <strong>Telefon Hattı</strong>
                <p>{businessConfig.contact.phone}</p>
                <span class="sub-note">Santral ve paket servis hattımız açılış gününde aktifleşecektir.</span>
              </div>
            </div>

            <!-- Çalışma Saatleri -->
            <div class="info-box card">
              <div class="info-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="info-text">
                <strong>Açılış Sonrası Çalışma Saatleri</strong>
                <p>Pazartesi - Cumartesi: 11:30 - 22:30<br/>Pazar: 12:00 - 22:00</p>
                <span class="sub-note">{businessConfig.hours.statusNote}</span>
              </div>
            </div>
          </div>

          <div class="directions-button-wrap">
            <a 
              href={businessConfig.contact.googleMapsUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-primary btn-lg"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
              </svg>
              <span>Google Haritalar'da Yol Tarifi Al</span>
            </a>
          </div>
        </div>

        <!-- Sağ Sütun: İletişim Formu -->
        <div class="contact-form-col">
          <ContactForm />
        </div>
      </div>

      <!-- Harita Bölümü -->
      <div class="map-section-wrap card">
        <div class="map-header">
          <h3>Güzelyalı Mahallesi Harita Konumu</h3>
          <p>Adana / Çukurova Güzelyalı bölgesindeki restoranımızın genel konum haritası.</p>
        </div>
        <iframe
          src={businessConfig.contact.googleMapsEmbedUrl}
          title="Güzelyalı Dönercisi Haritası"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding: 64px 0 40px;
    background-color: var(--color-surface);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin: 12px 0 6px;
  }

  .page-lead {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .contact-page-content {
    padding: 72px 0 96px;
    background-color: var(--color-bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    margin-bottom: 64px;
    align-items: flex-start;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-info-col .badge {
    align-self: flex-start;
  }

  .contact-info-col h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.3rem);
    color: var(--color-ink);
  }

  .info-lead {
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .info-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 6px;
  }

  .info-box {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    background-color: var(--color-surface);
  }

  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background-color: var(--color-burgundy-light);
    color: var(--color-burgundy);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-text strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .info-text p {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .info-text a {
    color: var(--color-burgundy);
    font-weight: 600;
  }

  .sub-note {
    display: block;
    font-size: 0.78rem;
    color: var(--color-muted);
    margin-top: 4px;
  }

  .directions-button-wrap {
    margin-top: 8px;
  }

  /* Harita Kapsayıcısı */
  .map-section-wrap {
    background-color: var(--color-surface);
    overflow: hidden;
  }

  .map-header {
    padding: 24px 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .map-header h3 {
    font-size: 1.35rem;
    margin-bottom: 4px;
  }

  .map-header p {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .map-section-wrap iframe {
    display: block;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
