---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { businessConfig } from '@/config/business';

const pageTitle = 'Adana İskender Döner & Tereyağlı Pide Lezzeti | Güzelyalı Dönercisi';
const pageDescription = "Güzelyalı Dönercisi'nde hakiki yaprak et dönerden hazırlanan Bursa usulü İskender. Közde kızarmış tırnak pide, özel domates sosu, manda yoğurdu ve köpüklü tereyağı.";

const breadcrumbs = [
  { name: 'Adana İskender', url: '/adana-iskender' }
];

const faqItems = [
  {
    question: "Güzelyalı Dönercisi İskender'inde hangi döner kullanılır?",
    answer: "İskender tabağımızda hazır kıyma veya karma döner kesinlikle yer almaz. Köz ateşinde pişirilen %100 yaprak et dönerimizden taze kesilen ince yapraklar kullanılır."
  },
  {
    question: "Pide ve sos nasıl hazırlanır?",
    answer: "Taş fırından yeni çıkmış tırnaklı pideler köz ateşinde hafif çıtırdatılarak lokmalık kesilir. Üzerine yaz domateslerinden ve tereyağından kaynatılan özel domates sosumuz sıcak olarak gezdirilir."
  },
  {
    question: "İskender'in yanında hangi yoğurt servis edilir?",
    answer: "Tabakta lezzeti dengelemek için geleneksel kıvamlı manda yoğurdu (veya isteğe göre tam yağlı tava yoğurdu) taze ve soğuk olarak yer alır."
  },
  {
    question: "Tereyağı masada mı dökülür?",
    answer: "Evet; bakır tavada köpürtülen hakiki yayık tereyağı, misafirimizin isteğine göre tam masaya ulaştığı anda sıcak olarak tabağın üzerinde gezdirilir."
  },
  {
    question: "İskender porsiyon seçenekleri nelerdir?",
    answer: "Tek porsiyon (120g et) ve 1.5 porsiyon (180g et) alternatiflerinin yanı sıra özel ikram mezelerimizle servis edilir."
  }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/adana-iskender"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <div class="pillar-hero">
    <div class="container">
      <div class="pillar-hero-grid">
        <div class="pillar-hero-content">
          <span class="badge badge-brass">Geleneksel Tereyağlı Lezzet</span>
          <h1>Adana’da Hakiki <br /><span class="text-burgundy">Yaprak Et İskender</span> Keyfi</h1>
          <div class="divider-brass"></div>
          <p class="pillar-lead">
            Közde nar gibi kızaran ince yaprak et döner, taş fırından çıtır tırnak pide, ağır ateşte kaynayan domates sosu ve bakır tavada cızırdayan yayık tereyağı. Güzelyalı Dönercisi olarak Adana'da İskender deneyimini hakiki et ustalığıyla yeniden tanımlıyoruz.
          </p>

          <div class="hero-action-buttons">
            <a href="/menu#cat-iskender" class="btn btn-primary btn-lg">
              <span>İskender Menüsünü Gör</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="/rezervasyon" class="btn btn-secondary btn-lg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
              </svg>
              <span>Masa Rezervasyonu</span>
            </a>
            <a 
              href={businessConfig.contact.googleMapsUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-outline btn-lg"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
              </svg>
              <span>Yol Tarifi</span>
            </a>
          </div>
        </div>

        <div class="pillar-hero-media">
          <div class="media-card">
            <img 
              src="/images/menu/iskender.webp" 
              alt="Güzelyalı Dönercisi tereyağlı soslu tırnak pideli hakiki yaprak et İskender porsiyonu" 
              width="1200" 
              height="800" 
              loading="eager"
              decoding="async"
              class="pillar-img"
            />
            <div class="media-badge">
              <strong>Bursa Usulü Ustalık</strong>
              <span>Hakiki Yayık Tereyağı • Manda Yoğurdu</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- İskenderin 4 Temel Unsuru -->
  <section class="section elements-section" aria-label="İskenderin Dört Unsuru">
    <div class="container">
      <div class="section-header-center">
        <span class="badge badge-burgundy">Kusursuz Uyum</span>
        <h2>Gerçek Bir İskenderi Benzersiz Kılan 4 Unsur</h2>
        <div class="divider-brass"></div>
        <p class="section-subtext">
          İskender; parçaların rastgele bir araya getirildiği bir tabak değil, her malzemenin birbirini tamamladığı bir gastronomi dengesidir.
        </p>
      </div>

      <div class="elements-grid">
        <div class="element-box card">
          <div class="element-icon">🥩</div>
          <h3>1. Saf Yaprak Et</h3>
          <p>
            Kıymayla şişirilmiş ağır dönerler yerine, dinlendirilmiş yerli danadan ince ince yaprak kesim. Et sosun altında erimez, karakterini korur.
          </p>
        </div>

        <div class="element-box card">
          <div class="element-icon">🥖</div>
          <h3>2. Közde Çıtır Pide</h3>
          <p>
            Özel taş fırın tırnak pidelerimiz, köz ateşinde hafifçe kızartılarak sosu içine çekecek ve hamurlaşmayacak kıvamda dilimlenir.
          </p>
        </div>

        <div class="element-box card">
          <div class="element-icon">🍅</div>
          <h3>3. Hakiki Domates Sosu</h3>
          <p>
            Güneşte olgunlaşmış domatesler, tatlı biber salçası ve hafif et suyuyla saatlerce kaynatılarak hazırlanan yoğun aromalı doğal sos.
          </p>
        </div>

        <div class="element-box card">
          <div class="element-icon">🧈</div>
          <h3>4. Cızırdayan Yayık Tereyağı</h3>
          <p>
            Tuzsuz doğal yayık tereyağı bakır tavada köpük köpük kızdırılır ve masanıza servis anında dökülerek kokusuyla iştah açar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Manda Yoğurdu ve Sunum Kültürü -->
  <section class="section side-harmony-section" aria-label="Yoğurt ve Garnitür Dengesi">
    <div class="container">
      <div class="content-split-grid">
        <div class="split-media">
          <img 
            src="/images/craft/usta-kesim.webp" 
            alt="Usta tarafından sipariş anında ince yapraklar halinde kesilen taze et döner" 
            width="1000" 
            height="700" 
            loading="lazy" 
            decoding="async" 
            class="rounded-image"
          />
        </div>

        <div class="split-text">
          <span class="badge badge-brass">Damak Uyumu</span>
          <h2>Manda Yoğurdunun Ferahlığı, Köz Biberin Aroması</h2>
          <div class="divider-brass"></div>
          <p>
            Zengin soslu ve tereyağlı bir et tabağının yanında yoğurdun niteliği belirleyicidir. Sulandırılmış sıradan yoğurtlar tabağın sıcaklığını bozar ve lezzeti seyreltir.
          </p>
          <p>
            Güzelyalı Dönercisi’nde İskender tabaklarımız; yoğun kıvamlı, hafif mayhoş manda yoğurdu, közde kabuğu soyulmuş Adana acı biberi ve köz domates eşliğinde servis edilir. Her çatalda sıcak etin doygunluğu ile yoğurdun ferahlatıcı dengesi hissedilir.
          </p>

          <div class="guarantee-box">
            <strong>Güzelyalı Dönercisi Güvencesi:</strong>
            <p>Pidelerimiz asla sosta beklemiş olarak servis edilmez. Sipariş verildiği an taze fırınlanır ve sıcak sosla buluşturulur.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sıkça Sorulan Sorular -->
  <section class="section faq-section" aria-label="Sıkça Sorulan Sorular">
    <div class="container">
      <div class="section-header-center">
        <span class="badge badge-burgundy">Merak Edilenler</span>
        <h2>İskender Döner Hakkında Sıkça Sorulan Sorular</h2>
        <div class="divider-brass"></div>
        <p class="section-subtext">
          Porsiyonlar, servis ayrıntıları ve malzeme kalitemiz.
        </p>
      </div>

      <div class="faq-container">
        {faqItems.map((faq, idx) => (
          <details class="faq-accordion-item card" open={idx === 0}>
            <summary class="faq-question">
              <span class="q-icon">?</span>
              <span class="q-text">{faq.question}</span>
              <span class="chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="section cta-banner-section" aria-label="Rezervasyon ve Menü">
    <div class="container">
      <div class="cta-banner card">
        <div class="cta-banner-text">
          <h2>Adana Çukurova’da İskender Ziyafetine Hazır Olun</h2>
          <p>
            Güzelyalı Mahallesi'ndeki nezih salonumuzda çok yakında kapılarımızı açıyoruz. Menümüzdeki diğer lezzetleri inceleyebilir veya masa rezervasyonu talebinizi iletebilirsiniz.
          </p>
        </div>
        <div class="cta-banner-actions">
          <a href="/menu" class="btn btn-primary btn-lg">Tüm Menüyü İncele</a>
          <a href="/adana-yaprak-doner" class="btn btn-secondary btn-lg">Yaprak Dönerimizi Keşfedin</a>
          <a href="/rezervasyon" class="btn btn-outline btn-lg">Masa Rezervasyonu</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pillar-hero {
    padding: 72px 0 56px;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .pillar-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .pillar-lead {
    font-size: 1.12rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
    margin: 20px 0 32px;
  }

  .hero-action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .media-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border);
  }

  .pillar-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .media-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background-color: rgba(23, 18, 16, 0.92);
    backdrop-filter: blur(8px);
    color: #FAF7F2;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-brass);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .media-badge strong {
    font-size: 1.05rem;
    color: var(--color-brass);
  }

  .media-badge span {
    font-size: 0.82rem;
    opacity: 0.85;
  }

  .section {
    padding: 80px 0;
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 52px;
  }

  .section-subtext {
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    margin-top: 14px;
    line-height: 1.65;
  }

  /* 4 Unsur Izgarası */
  .elements-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .element-box {
    padding: 32px 24px;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .element-box:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-brass);
  }

  .element-icon {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .element-box h3 {
    font-size: 1.2rem;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .element-box p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* Split Grid */
  .content-split-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }

  .split-text p {
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
    margin-bottom: 16px;
  }

  .rounded-image {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  .guarantee-box {
    background-color: var(--color-surface);
    border-left: 4px solid var(--color-burgundy);
    padding: 18px 22px;
    border-radius: var(--radius-sm);
    margin-top: 24px;
  }

  .guarantee-box strong {
    display: block;
    color: var(--color-burgundy);
    font-size: 0.95rem;
    margin-bottom: 4px;
  }

  .guarantee-box p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    margin: 0;
  }

  /* FAQ */
  .faq-container {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-accordion-item {
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .faq-question {
    padding: 20px 24px;
    cursor: pointer;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    gap: 14px;
    user-select: none;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .q-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--color-brass-light);
    color: var(--color-brass);
    font-weight: 800;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .q-text {
    flex: 1;
  }

  .chevron {
    font-size: 1.2rem;
    color: var(--color-muted);
    transition: transform var(--transition-fast);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 24px 22px 66px;
  }

  .faq-answer p {
    font-size: 0.96rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* CTA Banner */
  .cta-banner {
    background: linear-gradient(135deg, #171210 0%, #2A1F1B 100%);
    color: #FAF7F2;
    padding: 56px 48px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    border-left: 5px solid var(--color-brass);
  }

  .cta-banner-text h2 {
    color: #FAF7F2;
    font-size: 1.9rem;
    margin-bottom: 12px;
  }

  .cta-banner-text p {
    color: #E2DAD0;
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 580px;
    margin: 0;
  }

  .cta-banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .elements-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 992px) {
    .pillar-hero-grid,
    .content-split-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .cta-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 40px 28px;
    }
  }

  @media (max-width: 640px) {
    .elements-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
