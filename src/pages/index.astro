---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import BrandStorySection from '@/components/BrandStorySection.astro';
import SignatureDishes from '@/components/SignatureDishes.astro';
import SpecialtiesSection from '@/components/SpecialtiesSection.astro';
import NeYesemAssistant from '@/components/NeYesemAssistant.astro';
import WhyUs from '@/components/WhyUs.astro';
import ExperienceSection from '@/components/ExperienceSection.astro';
import LocationSection from '@/components/LocationSection.astro';

const pageTitle = 'Adana Döner & Yaprak Et Döner | Güzelyalı Dönercisi';
const pageDescription = "Adana Çukurova Güzelyalı'da yaprak et döner, döner dürüm ve İskender lezzetlerini keşfedin. Güzelyalı Dönercisi menüsü, konumu ve iletişim bilgileri.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  type="restaurant"
>
  <Hero />
  <BrandStorySection />
  <SignatureDishes />
  <SpecialtiesSection />
  <NeYesemAssistant />
  <WhyUs />
  <ExperienceSection />
  <LocationSection />
</BaseLayout>
