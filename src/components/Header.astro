---
import { businessConfig } from '@/config/business';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Ana Sayfa', href: '/' },
  { name: 'Menü', href: '/menu' },
  { name: 'Hakkımızda', href: '/hakkimizda' },
  { name: 'Lezzetimiz', href: '/lezzetimiz' },
  { name: 'Galeri', href: '/galeri' },
  { name: 'İletişim', href: '/iletisim' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-container">
    <!-- Marka Logosu -->
    <a href="/" class="header-logo" aria-label="Güzelyalı Dönercisi Ana Sayfa">
      <span class="logo-emblem">
        <svg viewBox="0 0 40 40" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="40" height="40" rx="10" fill="#7A1A22" />
          <circle cx="20" cy="20" r="17" stroke="#B88B4A" stroke-width="1" stroke-dasharray="2 2"/>
          <path d="M14 13h8c4 0 6 2.5 6 6s-2 6-6 6h-4v4h-4V13zm4 8h3.5c1.8 0 2.8-1 2.8-2.2s-1-2.2-2.8-2.2H18v4.4z" fill="#FAF7F2"/>
          <circle cx="28" cy="13" r="2" fill="#B88B4A"/>
        </svg>
      </span>
      <div class="logo-text-group">
        <span class="logo-brand">GÜZELYALI DÖNERCİSİ</span>
        <span class="logo-sub">ADANA • ÇUKUROVA</span>
      </div>
    </a>

    <!-- Masaüstü Navigasyon -->
    <nav class="desktop-nav" aria-label="Ana Menü">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href} 
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Sağ CTA'lar -->
    <div class="header-actions">
      {businessConfig.isOpeningSoon && (
        <span class="opening-badge">
          <span class="pulse-dot"></span>
          Çok Yakında
        </span>
      )}
      
      <a 
        href={businessConfig.contact.googleMapsUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-primary btn-sm cta-directions"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
        </svg>
        <span>Yol Tarifi</span>
      </a>

      <!-- Mobil Menü Aç/Kapat Butonu -->
      <button 
        id="mobileMenuToggle" 
        class="mobile-menu-toggle" 
        aria-label="Menüyü Aç/Kapat" 
        aria-expanded="false"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobil Menü Çekmecesi -->
  <div id="mobileDrawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-content">
      <div class="mobile-drawer-header">
        <div class="logo-text-group">
          <span class="logo-brand">GÜZELYALI DÖNERCİSİ</span>
          <span class="logo-sub">ADANA</span>
        </div>
        <button id="mobileDrawerClose" class="mobile-drawer-close" aria-label="Menüyü Kapat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-nav" aria-label="Mobil Menü">
        <ul>
          {navItems.map((item) => (
            <li>
              <a 
                href={item.href} 
                class:list={['mobile-nav-link', { active: isActive(item.href) }]}
              >
                <span>{item.name}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-drawer-footer">
        <div class="status-box">
          <strong>{businessConfig.openingStatusText}</strong>
          <p>{businessConfig.contact.address.fullText}</p>
        </div>

        <a 
          href={businessConfig.contact.googleMapsUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
          </svg>
          Google Haritalar'da Aç
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    height: var(--header-height);
    background-color: rgba(250, 247, 242, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-base);
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-emblem {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-text-group {
    display: flex;
    flex-direction: column;
  }

  .logo-brand {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    line-height: 1.1;
  }

  .logo-sub {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-brass);
    text-transform: uppercase;
  }

  .desktop-nav {
    display: block;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    position: relative;
    padding: 8px 0;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-burgundy);
    transition: width var(--transition-base);
  }

  .nav-link:hover {
    color: var(--color-burgundy);
  }

  .nav-link.active {
    color: var(--color-burgundy);
  }

  .nav-link.active::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .opening-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background-color: #FEF7EA;
    color: #9A5A05;
    border: 1px solid #F5DBAC;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #D97706;
    border-radius: 50%;
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.7); }
    70% { transform: scale(1.05); box-shadow: 0 0 0 6px rgba(217, 119, 6, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(217, 119, 6, 0); }
  }

  .mobile-menu-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-direction: column;
    gap: 5px;
  }

  .hamburger-bar {
    width: 24px;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  /* Mobil Menü Çekmecesi */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(28, 22, 20, 0.6);
    backdrop-filter: blur(4px);
    z-index: 2000;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .mobile-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 85%;
    max-width: 360px;
    background-color: var(--color-bg);
    display: flex;
    flex-direction: column;
    padding: 24px;
    transform: translateX(100%);
    transition: transform var(--transition-base);
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.15);
  }

  .mobile-drawer.open .mobile-drawer-content {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 20px;
  }

  .mobile-drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-ink);
    padding: 6px;
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ink);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    background-color: var(--color-surface-subtle);
    color: var(--color-burgundy);
  }

  .mobile-drawer-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .status-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 14px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
  }

  .status-box strong {
    display: block;
    color: var(--color-burgundy);
    margin-bottom: 4px;
  }

  .status-box p {
    color: var(--color-muted);
  }

  @media (max-width: 992px) {
    .desktop-nav {
      display: none;
    }

    .cta-directions {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobileMenuToggle') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('mobileDrawerClose') as HTMLButtonElement | null;
    const drawer = document.getElementById('mobileDrawer') as HTMLElement | null;

    if (!toggle || !closeBtn || !drawer) return;

    const navToggle = toggle;
    const navDrawer = drawer;

    function openMenu() {
      navDrawer.classList.add('open');
      navDrawer.setAttribute('aria-hidden', 'false');
      navToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      navDrawer.classList.remove('open');
      navDrawer.setAttribute('aria-hidden', 'true');
      navToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    navToggle.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    navDrawer.addEventListener('click', (e) => {
      if (e.target === navDrawer) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navDrawer.classList.contains('open')) {
        closeMenu();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
