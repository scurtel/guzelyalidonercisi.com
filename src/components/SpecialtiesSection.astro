---
const specialties = [
  {
    badge: 'İmza Lezzet',
    title: 'Adana Yaprak Döner',
    description: 'Kıymasız, katkısız, 24 saat süt ve taze baharat terbiyesinde dinlendirilmiş yerli dana antrikot ve kuzu döş lezzeti. Doğal köz ateşinde nar gibi kızaran saf yaprak et.',
    image: '/images/menu/yaprak-et-doner.webp',
    link: '/adana-yaprak-doner',
    ctaText: 'Yaprak Döneri İncele',
  },
  {
    badge: 'Geleneksel Sos & Tereyağı',
    title: 'Güzelyalı İskender',
    description: 'Közde kızarmış tırnak pide, özel domates sosu, manda yoğurdu ve bakır tavada cızırdayan yayık tereyağı eşliğinde ince kesim hakiki yaprak döner ziyafeti.',
    image: '/images/menu/iskender.webp',
    link: '/adana-iskender',
    ctaText: 'İskender Detayları',
  },
  {
    badge: 'Gastronomi Rehberi',
    title: 'Adana Döner Rehberi',
    description: 'Adana’da hakiki yaprak döner nasıl seçilir, kıyma dönerden nasıl ayırt edilir? Et kalitesi, köz ateşi ve Çukurova döner kültürüne dair uzman rehberi.',
    image: '/images/craft/usta-kesim.webp',
    link: '/adana-doner-rehberi',
    ctaText: 'Rehberi Oku',
  },
];
---

<section class="specialties-section" aria-label="Özel Lezzetler ve Rehberler">
  <div class="container">
    <div class="section-header-center">
      <span class="badge badge-brass">Öne Çıkan Başlıklar</span>
      <h2>Adana’nın Döner Ustalığını Keşfedin</h2>
      <div class="divider-brass"></div>
      <p class="section-subtext">
        Etin seçiminden köz ateşine, tırnak pideden manda yoğurduna kadar her detayda gerçek lezzeti sunuyoruz.
      </p>
    </div>

    <div class="specialties-grid">
      {specialties.map((item) => (
        <article class="specialty-card card">
          <div class="card-media">
            <img 
              src={item.image} 
              alt={item.title} 
              width="600" 
              height="400" 
              loading="lazy" 
              decoding="async" 
            />
            <span class="media-tag">{item.badge}</span>
          </div>

          <div class="card-body">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="card-footer-action">
              <a href={item.link} class="specialty-link">
                <span>{item.ctaText}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .specialties-section {
    padding: 88px 0;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 52px;
  }

  .section-subtext {
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    margin-top: 14px;
    line-height: 1.65;
  }

  .specialties-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .specialty-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .specialty-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-brass);
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .specialty-card:hover .card-media img {
    transform: scale(1.05);
  }

  .media-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: rgba(23, 18, 16, 0.9);
    backdrop-filter: blur(6px);
    color: var(--color-brass);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-body {
    padding: 28px 24px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-body h3 {
    font-size: 1.35rem;
    color: var(--color-ink);
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .card-body p {
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin-bottom: 24px;
    flex: 1;
  }

  .card-footer-action {
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .specialty-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-burgundy);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .specialty-link:hover {
    color: var(--color-burgundy-hover);
    transform: translateX(4px);
  }

  @media (max-width: 992px) {
    .specialties-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
