---
import { businessConfig } from '@/config/business';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  type?: 'website' | 'restaurant' | 'article';
  breadcrumbs?: Array<{ name: string; url: string }>;
  structuredData?: Record<string, any>;
}

const {
  title = `${businessConfig.brandName} | Adana Güzelyalı'da Gerçek Döner Ustalığı`,
  description = businessConfig.metaDescription,
  canonicalPath = '',
  ogImage = '/images/hero-doner.webp',
  type = 'restaurant',
  breadcrumbs = [],
  structuredData,
} = Astro.props;

const siteUrl = businessConfig.site.url;
const rawPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = (rawPath === '/' || rawPath === '') 
  ? siteUrl 
  : `${siteUrl}${rawPath.endsWith('/') ? rawPath : `${rawPath}/`}`;
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Schema.org Restaurant / LocalBusiness JSON-LD
const restaurantSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${siteUrl}/#restaurant`,
  name: businessConfig.brandName,
  legalName: businessConfig.legalName,
  url: siteUrl,
  image: fullOgImageUrl,
  description: businessConfig.shortDescription,
  servesCuisine: ['Turkish', 'Yaprak Et Döner', 'Döner', 'İskender', 'Kebap'],
  priceRange: '₺₺',
  address: {
    '@type': 'PostalAddress',
    streetAddress: businessConfig.contact.address.street,
    addressLocality: 'Çukurova',
    addressRegion: 'Adana',
    postalCode: businessConfig.contact.address.postalCode,
    addressCountry: 'TR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: businessConfig.contact.coordinates.latitude,
    longitude: businessConfig.contact.coordinates.longitude,
  },
  hasMap: businessConfig.contact.googleMapsUrl,
  sameAs: [
    businessConfig.social.instagram,
    'https://maps.app.goo.gl/XHxKeHS4UhTNiNWv6',
    'https://www.google.com/maps/place/Adana+G%C3%BCzelyal%C4%B1+D%C3%B6nercisi+-+Me%C5%9Fhur+Adana+D%C3%B6ner/@37.0488743,35.2933616,17z/data=!3m1!4b1!4m6!3m5!1s0x152889cc0ed16519:0xc9f41e67778d66d3!8m2!3d37.04887!4d35.2959419!16s%2Fg%2F11hz334skl'
  ].filter(Boolean),
  openingHoursSpecification: businessConfig.hours.schedule.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days.trim() === 'Pazar' 
      ? ['Sunday'] 
      : ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: h.opens,
    closes: h.closes,
  })),
  menu: `${siteUrl}/menu/`,
  acceptsReservations: businessConfig.reservations?.enabled ? 'True' : 'False',
  potentialAction: [
    {
      '@type': 'ViewAction',
      target: `${siteUrl}/menu/`,
      name: 'Menüyü İncele',
    },
    ...(businessConfig.reservations?.enabled ? [{
      '@type': 'ReserveAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/rezervasyon/`,
        inLanguage: 'tr-TR',
        actionPlatform: [
          'http://schema.org/DesktopWebPlatform',
          'http://schema.org/MobileWebPlatform'
        ]
      },
      result: {
        '@type': 'FoodEstablishmentReservation',
        name: 'Masa Rezervasyonu'
      }
    }] : [])
  ],
};

// BreadcrumbList Schema
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Ana Sayfa',
      item: siteUrl,
    },
    ...breadcrumbs.map((bc, idx) => {
      const bUrl = bc.url.startsWith('/') ? bc.url : `/${bc.url}`;
      const itemUrl = bUrl === '/' ? siteUrl : `${siteUrl}${bUrl.endsWith('/') ? bUrl : `${bUrl}/`}`;
      return {
        '@type': 'ListItem',
        position: idx + 2,
        name: bc.name,
        item: itemUrl,
      };
    }),
  ],
} : null;
---

<!-- Temel Meta Etiketleri -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index, follow" />
<meta name="author" content={businessConfig.site.author} />
<meta name="theme-color" content={businessConfig.site.themeColor} />

<!-- Favicon & PWA -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type === 'restaurant' ? 'restaurant.restaurant' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImageUrl} />
<meta property="og:site_name" content={businessConfig.brandName} />
<meta property="og:locale" content={businessConfig.site.locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImageUrl} />

<!-- Preconnect Google Fonts for performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Yapılandırılmış Veri (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
{structuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
)}
