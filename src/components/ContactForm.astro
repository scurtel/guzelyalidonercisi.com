---
/**
 * Güzelyalı Dönercisi - İletişim Formu Bileşeni
 * 
 * Güvenlik:
 * - Honeypot spam koruması
 * - İstemci & sunucu doğrulaması
 * - /api/contact.php üzerinden güvenli asenkron gönderim
 */
---

<div class="contact-form-container card">
  <div class="form-intro">
    <h3 class="form-title">Bize Mesaj Gönderin</h3>
    <p class="form-subtitle">
      Açılış hazırlıklarımız, menümüz veya toplu sipariş taleplerinizle ilgili sorularınızı iletebilirsiniz.
    </p>
  </div>

  <form id="contactForm" class="contact-form" novalidate>
    <!-- Honeypot Bot Kapanı (İnsanlar görmez, botlar doldurur) -->
    <div style="display:none !important;" aria-hidden="true">
      <label for="website_url">Web Sitesi</label>
      <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="fullName" class="form-label">Adınız ve Soyadınız <span class="required">*</span></label>
        <input 
          type="text" 
          id="fullName" 
          name="fullName" 
          class="form-input" 
          placeholder="Örn: Danyal Çilli" 
          required 
          minlength="2" 
          maxlength="80" 
        />
        <span class="field-error" id="fullNameError"></span>
      </div>

      <div class="form-group">
        <label for="phone" class="form-label">Telefon Numaranız</label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          class="form-input" 
          placeholder="Örn: 0532 000 00 00" 
          maxlength="20" 
        />
        <span class="field-error" id="phoneError"></span>
      </div>
    </div>

    <div class="form-group">
      <label for="email" class="form-label">E-posta Adresiniz <span class="required">*</span></label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        class="form-input" 
        placeholder="Örn: adiniz@ornek.com" 
        required 
      />
      <span class="field-error" id="emailError"></span>
    </div>

    <div class="form-group">
      <label for="message" class="form-label">Mesajınız <span class="required">*</span></label>
      <textarea 
        id="message" 
        name="message" 
        class="form-textarea" 
        placeholder="Sorunuzu, önerinizi veya talebinizi buraya yazabilirsiniz..." 
        required 
        minlength="5" 
        maxlength="2000"
      ></textarea>
      <span class="field-error" id="messageError"></span>
    </div>

    <button type="submit" id="contactSubmit" class="btn btn-primary btn-submit">
      <span class="btn-text">Mesajı Gönder</span>
      <span class="btn-spinner" style="display: none;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="animate-spin">
          <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
          <path d="M12 2a10 10 0 0 1 10 10"></path>
        </svg>
      </span>
    </button>

    <div id="formStatus" class="form-status" style="display: none;" role="alert"></div>
  </form>
</div>

<style>
  .contact-form-container {
    padding: 36px;
    background-color: var(--color-surface);
  }

  .form-intro {
    margin-bottom: 24px;
  }

  .form-title {
    font-size: 1.5rem;
    color: var(--color-ink);
    margin-bottom: 6px;
  }

  .form-subtitle {
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .required {
    color: var(--color-burgundy);
  }

  .field-error {
    font-size: 0.78rem;
    color: #C53030;
    margin-top: 4px;
    min-height: 16px;
    display: block;
  }

  .btn-submit {
    align-self: flex-start;
    min-width: 170px;
    padding: 14px 28px;
  }

  .form-status {
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    margin-top: 8px;
    line-height: 1.5;
  }

  .form-status.success {
    background-color: #EDFDF2;
    border: 1px solid #C6F6D5;
    color: #22543D;
  }

  .form-status.error {
    background-color: #FFF5F5;
    border: 1px solid #FED7D7;
    color: #9B2C2C;
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .contact-form-container {
      padding: 24px 18px;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .btn-submit {
      width: 100%;
    }
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contactSubmit') as HTMLButtonElement | null;
    const statusBox = document.getElementById('formStatus');

    if (!form || !submitBtn || !statusBox) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const btnText = submitBtn.querySelector('.btn-text') as HTMLElement | null;
      const btnSpinner = submitBtn.querySelector('.btn-spinner') as HTMLElement | null;

      // Temel İstemci Doğrulaması
      const fullName = (document.getElementById('fullName') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();
      const honeypot = (document.getElementById('website_url') as HTMLInputElement).value;

      if (!fullName || fullName.length < 2) {
        alert('Lütfen ad ve soyadınızı belirtin.');
        return;
      }
      if (!email || !email.includes('@')) {
        alert('Lütfen geçerli bir e-posta adresi girin.');
        return;
      }
      if (!message || message.length < 5) {
        alert('Lütfen en az 5 karakterlik bir mesaj yazın.');
        return;
      }

      submitBtn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnSpinner) btnSpinner.style.display = 'inline-block';
      statusBox.style.display = 'none';

      try {
        const response = await fetch('/api/contact.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fullName,
            phone,
            email,
            message,
            website_url: honeypot
          })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          statusBox.className = 'form-status success';
          statusBox.textContent = result.message || 'Mesajınız başarıyla iletildi. En kısa sürede sizinle iletişime geçeceğiz.';
          statusBox.style.display = 'block';
          form.reset();
        } else {
          statusBox.className = 'form-status error';
          statusBox.textContent = result.error || 'Mesaj gönderilemedi. Lütfen daha sonra tekrar deneyin.';
          statusBox.style.display = 'block';
        }
      } catch (err) {
        statusBox.className = 'form-status error';
        statusBox.textContent = 'Bağlantı hatası oluştu. Lütfen doğrudan e-posta ile ulaşmayı deneyin.';
        statusBox.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline-block';
        if (btnSpinner) btnSpinner.style.display = 'none';
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:after-swap', setupContactForm);
</script>
