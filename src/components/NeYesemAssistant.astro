---
/**
 * Güzelyalı Dönercisi - "Ne Yesem?" Lezzet Danışmanı Bileşeni
 * 
 * Google Gemini API destekli lezzet öneri aracı.
 * Doğrudan /api/recommend.php sunucu endpoint'i üzerinden güvenli,
 * oran sınırlı ve menü verisine sıkı sıkıya bağlı (grounded) olarak çalışır.
 */
---

<section class="ne-yesem-section" aria-label="Ne Yesem Lezzet Asistanı">
  <div class="container">
    <div class="ne-yesem-card">
      <div class="ne-yesem-badge-wrap">
        <span class="badge badge-brass">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
          </svg>
          Lezzet Asistanı
        </span>
      </div>

      <div class="ne-yesem-header">
        <h2 class="ne-yesem-title">Kararsız mısınız? <span class="text-burgundy">"Ne Yesem?"</span></h2>
        <p class="ne-yesem-subtitle">
          Nasıl bir lezzet aradığınızı, açlık durumunuzu veya tercihlerinizi kısaca yazın; menümüzden size en uygun tabağı anında önerelim.
        </p>
      </div>

      <!-- Hızlı Öneri İpuçları -->
      <div class="quick-prompts" aria-label="Hızlı Seçenekler">
        <button type="button" class="quick-btn" data-prompt="Çok aç değilim ama lezzetli bir et döner istiyorum.">
          🍃 Hafif Bir Öğün
        </button>
        <button type="button" class="quick-btn" data-prompt="Çok açım, bol etli ve doyurucu bir tabak arıyorum.">
          🥩 Doyurucu Bir Tabak
        </button>
        <button type="button" class="quick-btn" data-prompt="Güzelyalı Dönercisi'nin en meşhur imza lezzeti nedir?">
          ⭐ İmza Lezzetiniz
        </button>
        <button type="button" class="quick-btn" data-prompt="Tereyağlı ve yoğurtlu zengin bir lezzet istiyorum.">
          🧈 Hakiki İskender
        </button>
      </div>

      <!-- Giriş Formu -->
      <form id="neYesemForm" class="ne-yesem-form">
        <div class="input-wrap">
          <input 
            type="text" 
            id="neYesemInput" 
            class="ne-yesem-input" 
            placeholder="Örn: Sıcak lavaş dürüm ve yanında ferah bir içecek arıyorum..." 
            maxlength="200" 
            required 
            aria-label="Nasıl bir yemek aradığınızı yazın"
          />
          <button type="submit" id="neYesemSubmit" class="btn btn-primary btn-submit">
            <span class="btn-text">Öneri Al</span>
            <span class="btn-spinner" style="display: none;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="animate-spin">
                <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                <path d="M12 2a10 10 0 0 1 10 10"></path>
              </svg>
            </span>
          </button>
        </div>
        <p class="form-disclaimer">
          🔒 Öneriler yalnızca Güzelyalı Dönercisi'nin taze menü verisiyle sınırlıdır.
        </p>
      </form>

      <!-- Yanıt Alanı -->
      <div id="neYesemResult" class="ne-yesem-result" style="display: none;" aria-live="polite">
        <div class="result-header">
          <span class="chef-icon">👨‍🍳</span>
          <strong>Usta Şefimizin Önerisi:</strong>
        </div>
        <div id="neYesemText" class="result-content"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .ne-yesem-section {
    padding: 60px 0;
    background-color: var(--color-surface-subtle);
  }

  .ne-yesem-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 44px 40px;
    box-shadow: var(--shadow-md);
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ne-yesem-badge-wrap {
    display: flex;
  }

  .ne-yesem-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .text-burgundy {
    color: var(--color-burgundy);
  }

  .ne-yesem-subtitle {
    font-size: 0.98rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .quick-prompts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .quick-btn {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-ink-soft);
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .quick-btn:hover {
    background-color: var(--color-burgundy-light);
    color: var(--color-burgundy);
    border-color: var(--color-burgundy);
  }

  .ne-yesem-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 6px;
  }

  .input-wrap {
    display: flex;
    gap: 12px;
    background-color: var(--color-bg);
    padding: 6px 6px 6px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .input-wrap:focus-within {
    border-color: var(--color-burgundy);
    box-shadow: 0 0 0 3px var(--color-burgundy-light);
  }

  .ne-yesem-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 0.98rem;
    color: var(--color-ink);
    outline: none;
  }

  .btn-submit {
    min-width: 120px;
  }

  .form-disclaimer {
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  /* Sonuç Kutusu */
  .ne-yesem-result {
    background: linear-gradient(135deg, #FAF7F2 0%, #F5EFEB 100%);
    border: 1px solid var(--color-brass);
    border-left: 4px solid var(--color-burgundy);
    border-radius: var(--radius-md);
    padding: 22px 24px;
    animation: fadeIn 0.35s ease;
  }

  .result-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--color-burgundy);
    font-size: 0.95rem;
  }

  .chef-icon {
    font-size: 1.3rem;
  }

  .result-content {
    font-size: 0.98rem;
    color: var(--color-ink);
    line-height: 1.7;
  }

  .result-content :global(strong) {
    color: var(--color-burgundy);
    font-weight: 700;
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .ne-yesem-card {
      padding: 28px 20px;
    }

    .input-wrap {
      flex-direction: column;
      padding: 10px;
      gap: 10px;
    }

    .ne-yesem-input {
      padding: 6px 0;
    }

    .btn-submit {
      width: 100%;
    }
  }
</style>

<script>
  function setupNeYesem() {
    const form = document.getElementById('neYesemForm') as HTMLFormElement | null;
    const input = document.getElementById('neYesemInput') as HTMLInputElement | null;
    const submitBtn = document.getElementById('neYesemSubmit') as HTMLButtonElement | null;
    const resultBox = document.getElementById('neYesemResult');
    const resultText = document.getElementById('neYesemText');
    const quickButtons = document.querySelectorAll('.quick-btn');

    if (!form || !input || !submitBtn || !resultBox || !resultText) return;

    quickButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-prompt');
        if (p) {
          input.value = p;
          form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const preference = input.value.trim();
      if (!preference) return;

      const btnText = submitBtn.querySelector('.btn-text') as HTMLElement | null;
      const btnSpinner = submitBtn.querySelector('.btn-spinner') as HTMLElement | null;

      // Loading durumu
      submitBtn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnSpinner) btnSpinner.style.display = 'inline-block';
      resultBox.style.display = 'none';

      try {
        const res = await fetch('/api/recommend.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ preference })
        });

        const data = await res.json();
        if (data && data.success && data.recommendation) {
          // Format bold text
          const formatted = data.recommendation
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\n/g, '<br/>');
          resultText.innerHTML = formatted;
          resultBox.style.display = 'block';
        } else {
          resultText.innerHTML = data.error || 'Öneri alınırken bir sorun oluştu. Lütfen tekrar deneyin.';
          resultBox.style.display = 'block';
        }
      } catch (err) {
        // Fallback doğrudan yerel yanıt
        resultText.innerHTML = 'Özel yaprak dönerimiz ve yanında buz gibi açık yayık ayranımız sofranın vazgeçilmezidir!';
        resultBox.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline-block';
        if (btnSpinner) btnSpinner.style.display = 'none';
      }
    });
  }

  setupNeYesem();
  document.addEventListener('astro:after-swap', setupNeYesem);
</script>
