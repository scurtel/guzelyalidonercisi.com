---
/**
 * Güzelyalı Dönercisi - Masa Rezervasyonu Formu Bileşeni
 * 
 * Özellikler:
 * - Ad Soyad, Telefon, Tarih, Saat, Kişi Sayısı, Not alanları
 * - Geçmiş tarih seçimi engelli (Bugünden başlayan takvim, maks 60 gün)
 * - Doğrulanmış servis çalışma saatleri (12:00 - 21:30)
 * - Kolay kişi sayısı hızlı seçimi (1-12 kişi)
 * - Telefon format doğrulama
 * - KVKK Aydınlatma Metni & modal onayı
 * - WhatsApp Rezervasyon Talebi aktarımı
 * - "Rezervasyonunuz işletme tarafından onaylandıktan sonra kesinleşecektir." teyit bildirimi
 * - Honeypot spam koruması
 */
import { businessConfig } from '@/config/business';

const allowedHours = businessConfig.reservations.allowedHours;
const minGuests = businessConfig.reservations.minGuests;
const maxGuests = businessConfig.reservations.maxGuests;
const whatsappNumber = businessConfig.reservations.whatsappNumber || businessConfig.contact.phoneRaw || '';
---

<div class="reservation-form-wrapper card">
  <div class="form-header">
    <div class="badge badge-brass">Masa Rezervasyonu</div>
    <h2 class="form-title">Masa Rezervasyon Talebi</h2>
    <p class="form-subtitle">
      Aşağıdaki formu doldurarak rezervasyon talebinizi kolayca iletebilirsiniz. Talebiniz işletmemize aktarılacak olup, <strong>rezervasyonunuz işletme tarafından onaylandıktan sonra kesinleşecektir.</strong>
    </p>
  </div>

  <form id="reservationForm" class="reservation-form" novalidate data-whatsapp={whatsappNumber}>
    <!-- Honeypot Bot Kapanı (Görünmez) -->
    <div style="display:none !important;" aria-hidden="true">
      <label for="rez_website_url">Web Sitesi</label>
      <input type="text" id="rez_website_url" name="website_url" tabindex="-1" autocomplete="off" />
    </div>

    <!-- 1. Satır: Ad Soyad & Telefon -->
    <div class="form-grid-2">
      <div class="form-group">
        <label for="rezFullName" class="form-label">
          Ad Soyad <span class="required" aria-hidden="true">*</span>
        </label>
        <input 
          type="text" 
          id="rezFullName" 
          name="fullName" 
          class="form-input" 
          placeholder="Örn: Danyal Çilli" 
          required 
          minlength="2" 
          maxlength="80" 
          autocomplete="name"
        />
        <span class="field-error" id="rezFullNameError" role="alert"></span>
      </div>

      <div class="form-group">
        <label for="rezPhone" class="form-label">
          Telefon Numarası <span class="required" aria-hidden="true">*</span>
        </label>
        <input 
          type="tel" 
          id="rezPhone" 
          name="phone" 
          class="form-input" 
          placeholder="Örn: 0532 123 45 67" 
          required 
          autocomplete="tel"
        />
        <span class="field-error" id="rezPhoneError" role="alert"></span>
      </div>
    </div>

    <!-- 2. Satır: Kişi Sayısı (Hızlı Butonlar + Seçim) -->
    <div class="form-group">
      <label class="form-label" for="rezGuests">
        Kişi Sayısı <span class="required" aria-hidden="true">*</span>
      </label>
      <div class="guest-selector-pills" role="radiogroup" aria-label="Kişi Sayısı Seçin">
        {[1, 2, 3, 4, 5, 6, 8, 10, 12].map((num) => (
          <button 
            type="button" 
            class:list={['guest-pill', { active: num === 2 }]} 
            data-guests={num}
            aria-pressed={num === 2 ? 'true' : 'false'}
          >
            {num} {num === 1 ? 'Kişi' : 'Kişi'}
          </button>
        ))}
      </div>
      <select id="rezGuests" name="guests" class="form-select guest-fallback-select" required>
        {Array.from({ length: maxGuests - minGuests + 1 }, (_, i) => i + minGuests).map((num) => (
          <option value={num} selected={num === 2}>
            {num} Kişi {num === 1 ? '(Tek Kişi)' : num >= 8 ? '(Geniş Masa)' : ''}
          </option>
        ))}
      </select>
      <span class="field-error" id="rezGuestsError" role="alert"></span>
    </div>

    <!-- 3. Satır: Tarih & Saat -->
    <div class="form-grid-2">
      <div class="form-group">
        <label for="rezDate" class="form-label">
          Rezervasyon Tarihi <span class="required" aria-hidden="true">*</span>
        </label>
        <input 
          type="date" 
          id="rezDate" 
          name="date" 
          class="form-input" 
          required 
        />
        <span class="field-error" id="rezDateError" role="alert"></span>
      </div>

      <div class="form-group">
        <label for="rezTime" class="form-label">
          Rezervasyon Saati <span class="required" aria-hidden="true">*</span>
        </label>
        <select id="rezTime" name="time" class="form-select" required>
          <option value="" disabled selected>Saat seçiniz</option>
          {allowedHours.map((hour) => (
            <option value={hour}>{hour}</option>
          ))}
        </select>
        <span class="field-error" id="rezTimeError" role="alert"></span>
      </div>
    </div>

    <!-- 4. Satır: Özel İstekler / Not -->
    <div class="form-group">
      <label for="rezNotes" class="form-label">
        Özel İstekler / Not <span class="optional">(İsteğe Bağlı)</span>
      </label>
      <textarea 
        id="rezNotes" 
        name="notes" 
        class="form-textarea" 
        placeholder="Bebek sandalyesi, masa konumu tercihi veya alerjen hassasiyeti gibi notlarınızı iletebilirsiniz..."
        maxlength="500"
        rows="3"
      ></textarea>
      <div class="textarea-footer">
        <span class="field-error" id="rezNotesError" role="alert"></span>
        <span class="char-count" id="rezNotesCount">0 / 500</span>
      </div>
    </div>

    <!-- 5. Satır: KVKK Aydınlatması ve Onay -->
    <div class="form-group-checkbox">
      <label class="checkbox-label" for="rezKvkk">
        <input type="checkbox" id="rezKvkk" name="kvkkConsent" required />
        <span class="checkbox-text">
          <button type="button" id="openKvkkModal" class="btn-text-link">KVKK Aydınlatma Metni'ni</button> okudum, kişisel verilerimin rezervasyon talebinin işlenmesi amacıyla kullanılmasını onaylıyorum. <span class="required" aria-hidden="true">*</span>
        </span>
      </label>
      <span class="field-error" id="rezKvkkError" role="alert"></span>
    </div>

    <!-- Gönder Butonu -->
    <div class="form-actions">
      <button type="submit" id="rezSubmitBtn" class="btn btn-primary btn-lg btn-submit">
        <span class="btn-text-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span class="btn-text">Rezervasyon Talebi Gönder</span>
        </span>
        <span class="btn-spinner" style="display: none;" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="animate-spin">
            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
            <path d="M12 2a10 10 0 0 1 10 10"></path>
          </svg>
        </span>
      </button>

      <div class="form-guarantee-note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Rezervasyonunuz işletme tarafından onaylandıktan sonra kesinleşecektir.</span>
      </div>
    </div>

    <!-- Durum Mesaj Kutusu -->
    <div id="rezStatusBox" class="rez-status-box" style="display: none;" role="alert"></div>
  </form>
</div>

<!-- KVKK Aydınlatma Metni Modalı -->
<div id="kvkkModal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="kvkkModalTitle">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 id="kvkkModalTitle">Kişisel Verilerin İşlenmesi Aydınlatma Metni</h3>
      <button type="button" id="closeKvkkModal" class="modal-close" aria-label="Kapat">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <p>
        <strong>Güzelyalı Dönercisi</strong> olarak, 6698 sayılı Kişisel Verilerin Korunması Kanunu (“KVKK”) uyarınca, veri sorumlusu sıfatıyla rezervasyon formumuz aracılığıyla paylaştığınız kişisel verilerinizin gizliliğine ve güvenliğine azami özen gösteriyoruz.
      </p>
      <h4>1. İşlenen Kişisel Veriler ve Amaç</h4>
      <p>
        Form üzerinden ilettiğiniz <em>Ad Soyad, Telefon Numarası, Rezervasyon Tarihi, Saati, Kişi Sayısı ve Özel Not</em> verileriniz; masa rezervasyonunuzun düzenlenmesi, müsaitlik doğrulaması yapılması ve rezervasyon teyidi için sizinle iletişime geçilmesi amaçlarıyla sınırlı olarak işlenmektedir.
      </p>
      <h4>2. Veri Güvenliği ve Aktarım</h4>
      <p>
        Verileriniz üçüncü şahıslara ticari amaçla satılmaz, devredilmez veya paylaşılmaz. Yalnızca yasal zorunluluk halinde ilgili resmi makamlarla paylaşılabilir.
      </p>
      <h4>3. Başvuru Hakkı</h4>
      <p>
        KVKK'nın 11. maddesi kapsamındaki haklarınıza ilişkin taleplerinizi <a href={`mailto:${businessConfig.contact.email}`}>{businessConfig.contact.email}</a> kurumsal e-posta adresimiz üzerinden iletebilirsiniz.
      </p>
    </div>
    <div class="modal-footer">
      <button type="button" id="confirmKvkkModal" class="btn btn-primary btn-sm">Okudum ve Anladım</button>
    </div>
  </div>
</div>

<style>
  .reservation-form-wrapper {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: var(--shadow-md);
  }

  .form-header {
    margin-bottom: 28px;
  }

  .form-title {
    font-size: clamp(1.8rem, 3.2vw, 2.2rem);
    color: var(--color-ink);
    margin: 12px 0 8px;
    font-family: var(--font-display);
  }

  .form-subtitle {
    font-size: 0.96rem;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 680px;
  }

  .form-subtitle strong {
    color: var(--color-burgundy);
  }

  .reservation-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .required {
    color: #DC2626;
  }

  .optional {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.95rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-burgundy);
    box-shadow: 0 0 0 3px rgba(122, 26, 34, 0.12);
  }

  .form-input.is-invalid, .form-select.is-invalid, .form-textarea.is-invalid {
    border-color: #DC2626;
    background-color: #FEF2F2;
  }

  .field-error {
    font-size: 0.78rem;
    color: #DC2626;
    min-height: 16px;
  }

  /* Kişi Sayısı Hızlı Seçim Butonları */
  .guest-selector-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 4px;
  }

  .guest-pill {
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .guest-pill:hover {
    border-color: var(--color-burgundy);
    color: var(--color-burgundy);
    background-color: var(--color-surface-subtle);
  }

  .guest-pill.active {
    background-color: var(--color-burgundy);
    border-color: var(--color-burgundy);
    color: #FFFFFF;
    box-shadow: 0 2px 6px rgba(122, 26, 34, 0.25);
  }

  .guest-fallback-select {
    display: none;
  }

  .textarea-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .char-count {
    font-size: 0.76rem;
    color: var(--color-muted);
  }

  /* KVKK Checkbox */
  .form-group-checkbox {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 4px;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    margin-top: 4px;
    width: 17px;
    height: 17px;
    accent-color: var(--color-burgundy);
    cursor: pointer;
  }

  .checkbox-text {
    font-size: 0.84rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .btn-text-link {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-burgundy);
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    font-size: inherit;
  }

  /* Form Aksiyonları */
  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 8px;
  }

  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    cursor: pointer;
  }

  .btn-text-wrap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .form-guarantee-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--color-muted);
    text-align: center;
  }

  .form-guarantee-note svg {
    color: #B88B4A;
    flex-shrink: 0;
  }

  /* Durum Bildirim Kutusu */
  .rez-status-box {
    padding: 18px 20px;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    line-height: 1.55;
    animation: fadeIn 0.3s ease;
  }

  .rez-status-box.success {
    background-color: #F0FDF4;
    border: 1px solid #BBF7D0;
    color: #166534;
  }

  .rez-status-box.error {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    color: #991B1B;
  }

  .rez-status-box strong {
    font-size: 1rem;
    display: block;
    margin-bottom: 4px;
  }

  .rez-copy-box {
    margin-top: 14px;
    padding: 12px;
    background: #FFFFFF;
    border: 1px dashed #86EFAC;
    border-radius: var(--radius-sm);
    font-family: monospace;
    font-size: 0.84rem;
    white-space: pre-line;
    color: #1F2937;
  }

  .rez-action-row {
    margin-top: 12px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(28, 22, 20, 0.65);
    backdrop-filter: blur(4px);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-backdrop.open {
    display: flex;
  }

  .modal-dialog {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    max-width: 620px;
    width: 100%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 40px rgba(0,0,0,0.25);
    border: 1px solid var(--color-border);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .modal-header h3 {
    font-size: 1.15rem;
    color: var(--color-ink);
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
  }

  .modal-close {
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
  }

  .modal-body {
    padding: 24px;
    overflow-y: auto;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }

  .modal-body h4 {
    font-size: 0.98rem;
    color: var(--color-ink);
    margin: 16px 0 6px;
  }

  .modal-body p {
    margin-bottom: 12px;
  }

  .modal-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: flex-end;
    background-color: var(--color-bg);
  }

  @media (max-width: 768px) {
    .reservation-form-wrapper {
      padding: 28px 18px;
    }

    .form-grid-2 {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>

<script>
  function setupReservationForm() {
    const form = document.getElementById('reservationForm') as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = document.getElementById('rezSubmitBtn') as HTMLButtonElement | null;
    const statusBox = document.getElementById('rezStatusBox') as HTMLElement | null;
    const dateInput = document.getElementById('rezDate') as HTMLInputElement | null;
    const notesInput = document.getElementById('rezNotes') as HTMLTextAreaElement | null;
    const notesCount = document.getElementById('rezNotesCount') as HTMLElement | null;
    const guestsSelect = document.getElementById('rezGuests') as HTMLSelectElement | null;
    const guestPills = document.querySelectorAll('.guest-pill');

    // Kişi sayısı pill butonları yönetimi
    guestPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        guestPills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-pressed', 'true');
        const num = pill.getAttribute('data-guests');
        if (guestsSelect && num) {
          guestsSelect.value = num;
        }
      });
    });

    // Tarih kısıtlamaları (Geçmiş tarih seçilemez, bugünden itibaren)
    if (dateInput) {
      const today = new Date();
      const pad = (n: number) => String(n).padStart(2, '0');
      const todayStr = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
      dateInput.min = todayStr;
      
      const maxDate = new Date();
      maxDate.setDate(maxDate.getDate() + 60);
      const maxDateStr = `${maxDate.getFullYear()}-${pad(maxDate.getMonth() + 1)}-${pad(maxDate.getDate())}`;
      dateInput.max = maxDateStr;

      if (!dateInput.value) {
        dateInput.value = todayStr;
      }
    }

    // Karakter Sayacı
    if (notesInput && notesCount) {
      notesInput.addEventListener('input', () => {
        notesCount.textContent = `${notesInput.value.length} / 500`;
      });
    }

    // Modal Yönetimi
    const openModalBtn = document.getElementById('openKvkkModal');
    const closeModalBtn = document.getElementById('closeKvkkModal');
    const confirmModalBtn = document.getElementById('confirmKvkkModal');
    const kvkkModal = document.getElementById('kvkkModal');
    const kvkkCheckbox = document.getElementById('rezKvkk') as HTMLInputElement | null;

    function openModal() {
      if (kvkkModal) {
        kvkkModal.classList.add('open');
        kvkkModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (kvkkModal) {
        kvkkModal.classList.remove('open');
        kvkkModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }

    openModalBtn?.addEventListener('click', openModal);
    closeModalBtn?.addEventListener('click', closeModal);
    confirmModalBtn?.addEventListener('click', () => {
      closeModal();
      if (kvkkCheckbox) kvkkCheckbox.checked = true;
    });

    kvkkModal?.addEventListener('click', (e) => {
      if (e.target === kvkkModal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && kvkkModal?.classList.contains('open')) {
        closeModal();
      }
    });

    // Form Gönderimi & WhatsApp Entegrasyonu
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !statusBox) return;

      // Hata alanlarını sıfırla
      form.querySelectorAll('.field-error').forEach((el) => { (el as HTMLElement).textContent = ''; });
      form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));

      const fullNameInput = document.getElementById('rezFullName') as HTMLInputElement;
      const phoneInput = document.getElementById('rezPhone') as HTMLInputElement;
      const dateValInput = document.getElementById('rezDate') as HTMLInputElement;
      const timeInput = document.getElementById('rezTime') as HTMLSelectElement;
      const notesValInput = document.getElementById('rezNotes') as HTMLTextAreaElement;
      const kvkkInput = document.getElementById('rezKvkk') as HTMLInputElement;
      const honeypotInput = document.getElementById('rez_website_url') as HTMLInputElement;

      let isValid = true;

      // 1. Ad Soyad kontrolü
      const fullName = fullNameInput.value.trim();
      if (!fullName || fullName.length < 2) {
        isValid = false;
        fullNameInput.classList.add('is-invalid');
        const err = document.getElementById('rezFullNameError');
        if (err) err.textContent = 'Lütfen adınızı ve soyadınızı belirtin (en az 2 karakter).';
      }

      // 2. Telefon kontrolü
      const phone = phoneInput.value.trim();
      const phoneDigits = phone.replace(/[^\d]/g, '');
      if (!phone || phoneDigits.length < 10) {
        isValid = false;
        phoneInput.classList.add('is-invalid');
        const err = document.getElementById('rezPhoneError');
        if (err) err.textContent = 'Lütfen geçerli bir telefon numarası girin (örn: 0532 123 45 67).';
      }

      // 3. Kişi Sayısı
      const guests = parseInt(guestsSelect ? guestsSelect.value : '2', 10);
      if (!guests || guests < 1 || guests > 12) {
        isValid = false;
        const err = document.getElementById('rezGuestsError');
        if (err) err.textContent = 'Lütfen geçerli bir kişi sayısı seçin.';
      }

      // 4. Tarih kontrolü
      const date = dateValInput.value;
      if (!date) {
        isValid = false;
        dateValInput.classList.add('is-invalid');
        const err = document.getElementById('rezDateError');
        if (err) err.textContent = 'Lütfen rezervasyon tarihi seçiniz.';
      } else {
        const selected = new Date(date);
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        if (selected < today) {
          isValid = false;
          dateValInput.classList.add('is-invalid');
          const err = document.getElementById('rezDateError');
          if (err) err.textContent = 'Geçmiş tarihlere rezervasyon yapılamaz.';
        }
      }

      // 5. Saat kontrolü
      const time = timeInput.value;
      if (!time) {
        isValid = false;
        timeInput.classList.add('is-invalid');
        const err = document.getElementById('rezTimeError');
        if (err) err.textContent = 'Lütfen rezervasyon saati seçiniz.';
      }

      // 6. KVKK Onayı
      if (!kvkkInput.checked) {
        isValid = false;
        const err = document.getElementById('rezKvkkError');
        if (err) err.textContent = 'Rezervasyon talebi için aydınlatma metnini onaylamanız gerekmektedir.';
      }

      if (!isValid) return;

      // Gönderim Durumu
      submitBtn.disabled = true;
      const btnTextWrap = submitBtn.querySelector('.btn-text-wrap') as HTMLElement | null;
      const btnSpinner = submitBtn.querySelector('.btn-spinner') as HTMLElement | null;
      if (btnTextWrap) btnTextWrap.style.display = 'none';
      if (btnSpinner) btnSpinner.style.display = 'inline-block';
      statusBox.style.display = 'none';

      // WhatsApp Mesaj Şablonu (Kullanıcı tarafından istenen kesin format)
      const formattedNote = notesValInput.value.trim() || 'Yok';
      const whatsappMessage = 
`Güzelyalı Dönercisi Rezervasyon Talebi

Ad Soyad: ${fullName}
Telefon: ${phone}
Tarih: ${date}
Saat: ${time}
Kişi Sayısı: ${guests}
Not: ${formattedNote}`;

      // WhatsApp Hedef Numarası
      const configuredWhatsapp = form.getAttribute('data-whatsapp') || '';
      const cleanWaNumber = configuredWhatsapp.replace(/[^\d]/g, '');

      try {
        // Backend'e de kayıt/bildirim olarak gönder
        await fetch('/api/reservation.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fullName,
            phone,
            date,
            time,
            guests,
            notes: formattedNote,
            kvkkConsent: kvkkInput.checked,
            website_url: honeypotInput ? honeypotInput.value : ''
          })
        }).catch(() => null);

        // Başarı mesajı ve durum ekranı
        statusBox.className = 'rez-status-box success';

        if (cleanWaNumber) {
          // Doğrulanmış WhatsApp numarası varsa doğrudan yönlendir
          const waUrl = `https://wa.me/${cleanWaNumber}?text=${encodeURIComponent(whatsappMessage)}`;
          statusBox.innerHTML = `
            <strong>Rezervasyon Talebiniz Hazırlandı!</strong>
            <p>WhatsApp uygulaması açılıyor. Lütfen açılan ekranda "Gönder" butonuna basarak talebinizi işletmemize iletiniz.</p>
            <p style="margin-top: 8px;"><em>Rezervasyonunuz işletme tarafından onaylandıktan sonra kesinleşecektir.</em></p>
            <div class="rez-action-row">
              <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                WhatsApp'ta Aç
              </a>
            </div>
          `;
          window.open(waUrl, '_blank');
        } else {
          // Açılış öncesi henüz resmi WhatsApp numarası atanmamışsa
          statusBox.innerHTML = `
            <strong>Rezervasyon Talebiniz Alındı!</strong>
            <p>Talebiniz işletmemize başarıyla iletilmiştir. <strong>Rezervasyonunuz işletme tarafından onaylandıktan sonra kesinleşecektir.</strong></p>
            <p style="margin-top: 6px; font-size: 0.88rem; color: #166534;">
              Ekibimiz telefon numaranız (${phone}) üzerinden sizinle iletişime geçerek masa müsaitliğinizi teyit edecektir.
            </p>
            <div class="rez-copy-box">${whatsappMessage}</div>
          `;
        }

        statusBox.style.display = 'block';
        form.reset();

        // Varsayılan tarihi tekrar bugüne al
        if (dateInput) {
          const today = new Date();
          const pad = (n: number) => String(n).padStart(2, '0');
          dateInput.value = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
        }
        if (notesCount) notesCount.textContent = '0 / 500';

        // Kişi sayısı butonunu 2'ye resetle
        guestPills.forEach((p) => {
          const isTwo = p.getAttribute('data-guests') === '2';
          p.classList.toggle('active', isTwo);
          p.setAttribute('aria-pressed', isTwo ? 'true' : 'false');
        });
        if (guestsSelect) guestsSelect.value = '2';

      } catch (err) {
        statusBox.className = 'rez-status-box error';
        statusBox.innerHTML = `
          <strong>Bağlantı Hatası:</strong><br />
          Talep iletilirken bir sorun oluştu. Lütfen bilgilerinizi kontrol edip tekrar deneyiniz.
        `;
        statusBox.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        if (btnTextWrap) btnTextWrap.style.display = 'inline-flex';
        if (btnSpinner) btnSpinner.style.display = 'none';
      }
    });
  }

  setupReservationForm();
  document.addEventListener('astro:after-swap', setupReservationForm);
</script>
