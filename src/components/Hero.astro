---
import { businessConfig } from '@/config/business';
---

<section class="hero-section" aria-label="Giriş Bölümü">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-wrap">
        <span class="badge badge-opening">
          <span class="pulse-dot"></span>
          {businessConfig.openingStatusText}
        </span>
      </div>

      <h1 class="hero-title">
        Güzelyalı’da Dönerin <br />
        <span class="text-accent">Yeni ve Hakiki</span> Adresi
      </h1>

      <p class="hero-lead">
        Özenle dinlendirilmiş dana ve kuzu eti, odun ve köz ateşinin ağır ağır işleyen sabrı, taptaze tırnaklı pide ve Çukurova’nın cömert misafirperverliği. Adana’ya yakışır bir döner ustalığı hazırlıyoruz.
      </p>

      <div class="hero-ctas">
        <a href="/menu" class="btn btn-primary btn-lg">
          <span>Menüyü Keşfedin</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a 
          href={businessConfig.contact.googleMapsUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary btn-lg"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
          </svg>
          <span>Konum & Yol Tarifi</span>
        </a>
      </div>

      <div class="hero-highlights">
        <div class="highlight-item">
          <span class="highlight-icon">🔥</span>
          <div class="highlight-text">
            <strong>Doğal Köz Ateşi</strong>
            <span>Ağır ve dengeli pişirme</span>
          </div>
        </div>
        <div class="highlight-divider"></div>
        <div class="highlight-item">
          <span class="highlight-icon">🥩</span>
          <div class="highlight-text">
            <strong>Yaprak Et Ustalığı</strong>
            <span>Özel terbiye ve ince kesim</span>
          </div>
        </div>
        <div class="highlight-divider"></div>
        <div class="highlight-item">
          <span class="highlight-icon">🌿</span>
          <div class="highlight-text">
            <strong>Günlük Tazelik</strong>
            <span>Sıcak pide & taze garnitür</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Hero Görseli & Sunum Kartı -->
    <div class="hero-media">
      <div class="media-frame">
        <img 
          src="/images/hero-doner.webp" 
          alt="Güzelyalı Dönercisi köz ateşinde pişen özel yaprak et döner sunumu" 
          width="1600" 
          height="900" 
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-img"
        />
        <div class="media-overlay-card">
          <div class="overlay-badge">İmza Sunum</div>
          <div class="overlay-title">Güzelyalı Yaprak Et Döner</div>
          <div class="overlay-desc">Özel marine antrikot & kuzu eti, köz biber ve sıcak tırnak pide eşliğinde.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 64px 0 80px;
    background: radial-gradient(circle at top right, rgba(184, 139, 74, 0.08) 0%, rgba(250, 247, 242, 0) 60%);
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hero-badge-wrap {
    display: flex;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #D97706;
    border-radius: 50%;
    animation: pulse 1.8s infinite;
  }

  .hero-title {
    font-size: clamp(2.4rem, 4.6vw, 3.8rem);
    line-height: 1.15;
    color: var(--color-ink);
  }

  .text-accent {
    color: var(--color-burgundy);
    position: relative;
    display: inline-block;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
    max-width: 580px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }

  .hero-highlights {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    margin-top: 12px;
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .highlight-icon {
    font-size: 1.4rem;
  }

  .highlight-text {
    display: flex;
    flex-direction: column;
  }

  .highlight-text strong {
    font-size: 0.88rem;
    color: var(--color-ink);
    line-height: 1.2;
  }

  .highlight-text span {
    font-size: 0.76rem;
    color: var(--color-muted);
  }

  .highlight-divider {
    width: 1px;
    height: 32px;
    background-color: var(--color-border);
  }

  /* Medya */
  .hero-media {
    position: relative;
  }

  .media-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(184, 139, 74, 0.2);
    aspect-ratio: 16 / 10;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .media-frame:hover .hero-img {
    transform: scale(1.03);
  }

  .media-overlay-card {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(28, 22, 20, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(184, 139, 74, 0.35);
    padding: 16px 20px;
    border-radius: var(--radius-md);
    color: #FAF7F2;
  }

  .overlay-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-brass);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .overlay-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: #FAF7F2;
    margin-bottom: 4px;
  }

  .overlay-desc {
    font-size: 0.82rem;
    color: #D6CBC5;
    line-height: 1.45;
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-section {
      padding: 40px 0 60px;
    }
  }

  @media (max-width: 600px) {
    .hero-highlights {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .highlight-divider {
      display: none;
    }
  }
</style>
