---
import { businessConfig } from '@/config/business';
---

<aside class="mobile-action-bar" aria-label="Hızlı İşlemler">
  <div class="action-bar-inner">
    <!-- Menü -->
    <a href="/menu" class="action-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
      <span>Menü</span>
    </a>

    <!-- Yol Tarifi (Birincil CTA) -->
    <a 
      href={businessConfig.contact.googleMapsUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="action-btn action-primary"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
      </svg>
      <span>Yol Tarifi</span>
    </a>

    <!-- Ara veya İletişim -->
    {businessConfig.contact.hasActivePhone ? (
      <a href={`tel:${businessConfig.contact.phoneRaw}`} class="action-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Ara</span>
      </a>
    ) : (
      <a href="/iletisim" class="action-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Konum</span>
      </a>
    )}
  </div>
</aside>

<style>
  .mobile-action-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 990;
    background-color: rgba(250, 247, 242, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border);
    padding: 8px 16px;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  }

  .action-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    max-width: 480px;
    margin: 0 auto;
    gap: 8px;
  }

  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex: 1;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .action-btn:hover {
    background-color: var(--color-surface-subtle);
    color: var(--color-burgundy);
  }

  .action-btn.action-primary {
    background-color: var(--color-burgundy);
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(122, 26, 34, 0.25);
  }

  .action-btn.action-primary:hover {
    background-color: var(--color-burgundy-hover);
  }

  @media (max-width: 768px) {
    .mobile-action-bar {
      display: block;
    }
  }
</style>
