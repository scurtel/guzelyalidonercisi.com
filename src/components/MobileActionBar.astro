---
import { businessConfig } from '@/config/business';
---

<aside class="mobile-action-bar" aria-label="Hızlı İşlemler">
  <div class="action-bar-inner">
    <!-- 1. Menü -->
    <a href="/menu" class="action-btn" aria-label="Lezzet Menüsü">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
      <span>Menü</span>
    </a>

    <!-- 2. Rezervasyon (Öne Çıkan CTA) -->
    <a href="/rezervasyon" class="action-btn action-primary" aria-label="Masa Rezervasyonu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span>Rezervasyon</span>
    </a>

    <!-- 3. Yol Tarifi -->
    <a 
      href={businessConfig.contact.googleMapsUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="action-btn"
      aria-label="Google Haritalar Yol Tarifi"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
      </svg>
      <span>Yol Tarifi</span>
    </a>
  </div>
</aside>

<style>
  .mobile-action-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 990;
    background-color: rgba(250, 247, 242, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border);
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  }

  .action-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 480px;
    margin: 0 auto;
    gap: 8px;
  }

  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    flex: 1;
    min-height: 48px;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: 0.74rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .action-btn:hover {
    background-color: var(--color-surface-subtle);
    color: var(--color-burgundy);
  }

  .action-btn.action-primary {
    background-color: var(--color-burgundy);
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(122, 26, 34, 0.25);
  }

  .action-btn.action-primary:hover {
    background-color: var(--color-burgundy-hover);
  }

  @media (max-width: 768px) {
    .mobile-action-bar {
      display: block;
    }
  }
</style>
