---
import { menuItems } from '@/data/menu';

const featuredDishes = menuItems.filter((item) => item.featured).slice(0, 4);
---

<section class="signature-section" aria-label="İmza Lezzetlerimiz">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-burgundy">Ustalıkla Hazırlanan Menü</span>
      <h2>Öne Çıkan İmza Lezzetler</h2>
      <div class="divider-brass"></div>
      <p>
        Günün her anında aynı tazelik ve kıvamda sunulan, özel terbiyeli yaprak et döner çeşitlerimiz.
      </p>
    </div>

    <div class="dishes-grid">
      {featuredDishes.map((dish) => (
        <article class="dish-card card">
          <div class="dish-media">
            <img 
              src={dish.image} 
              alt={dish.name} 
              width="800" 
              height="600" 
              loading="lazy"
              decoding="async"
              class="dish-img"
            />
            {dish.signature && (
              <span class="signature-badge">İmza Lezzet</span>
            )}
          </div>

          <div class="dish-body">
            <div class="dish-header">
              <h3 class="dish-title">{dish.name}</h3>
              <span class="dish-price-note">{dish.priceNote}</span>
            </div>

            <p class="dish-desc">{dish.description}</p>

            {dish.tags && dish.tags.length > 0 && (
              <div class="dish-tags">
                {dish.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
            )}

            {dish.portion && (
              <div class="dish-portion">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>{dish.portion}</span>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="section-cta-wrap">
      <a href="/menu" class="btn btn-primary btn-lg">
        <span>Tüm Menüyü İnceleyin</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .signature-section {
    padding: 92px 0;
    background-color: var(--color-bg);
  }

  .dishes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-bottom: 48px;
  }

  .dish-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .dish-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
  }

  .dish-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .dish-card:hover .dish-img {
    transform: scale(1.04);
  }

  .signature-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: linear-gradient(135deg, #B88B4A 0%, #9E7032 100%);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }

  .dish-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
  }

  .dish-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .dish-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .dish-price-note {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-muted);
    background-color: var(--color-surface-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    border: 1px solid var(--color-border);
  }

  .dish-desc {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
    flex: 1;
  }

  .dish-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .tag-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-burgundy);
    background-color: var(--color-burgundy-light);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }

  .dish-portion {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--color-muted);
    padding-top: 10px;
    border-top: 1px solid var(--color-border-subtle);
  }

  .section-cta-wrap {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 820px) {
    .dishes-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
